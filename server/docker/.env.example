# ============================================================
# Metin2Bausia — herní server, proměnné prostředí
# Zkopírovat jako server/docker/.env a vyplnit. .env se NEcommituje.
# Hesla a klíče generovat a uložit do Vaultwarden.
# ============================================================

# MySQL root heslo (upstream používá root pro web i jádra) — např. openssl rand -base64 24
MT2_MYSQL_PASSWORD=zde_doplnit

# Veřejná IP, na kterou se připojují klienti. Skutečnou adresu nikdy nedávat do repa.
MT2_PUBLIC_IP=zde_doplnit

# Web (Laravel) — spravuje SQL schéma, web, item shop a autopatcher.
# Klíč: docker run --rm git.old-metin2.com/metin2/web:latest "php artisan key:generate --show"
MT2_WEB_IMAGE=git.old-metin2.com/metin2/web:latest
MT2_WEB_APP_NAME=Bausia
MT2_WEB_APP_URL=http://localhost:8098
MT2_WEB_APP_KEY=zde_doplnit
MT2_WEB_PORT=8098

# E-mail webu — "log" posílá maily jen do logu, dokud není SMTP
MT2_MAIL_MAILER=log
MT2_MAIL_HOST=
MT2_MAIL_PORT=587
MT2_MAIL_USERNAME=
MT2_MAIL_PASSWORD=
MT2_MAIL_ENCRYPTION=tls
MT2_MAIL_FROM_ADDRESS=no-reply@example.com

# Hra
MT2_GAME_MAX_LEVEL=105
MT2_TEST_SERVER=0

# Jazyk názvů itemů a mobů (soubory item_names_<locale>.txt v server/src/gamefiles/conf)
MT2_LOCALE=cz
