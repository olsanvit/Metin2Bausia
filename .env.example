# ============================================================
# Metin2Bausia — Management stack .env
# Zkopíruj jako .env a uprav hodnoty
# Používá: docker-compose.yml (root) — PostgreSQL + MT2 MCP
# ============================================================

# PostgreSQL heslo (management DB)
POSTGRES_PASSWORD=changeme_postgres

# ntfy Basic auth pro MCP notifikace — formát: Basic <base64(user:heslo)>
# Nikdy nevkládat přímo do docker-compose.yml (soubor je ve veřejném repu)
NTFY_AUTH=Basic zde_doplnit
