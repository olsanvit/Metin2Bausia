@inherits LayoutComponentBase
@attribute [Authorize]

<div class="page">
    @* Mobilní menu bez JS: layout je SSR, @onclick by tu nereagoval — stav drží skrytý checkbox *@
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" tabindex="-1" />
    <label for="nav-toggle" class="nav-backdrop"></label>
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-3 px-md-4">
            <label for="nav-toggle" class="nav-toggle-btn" title="@S["Menu"]" aria-label="@S["Menu"]">☰</label>
            <a href="/" class="fw-semibold text-decoration-none text-body">@S["AdminTitle"]</a>

            @* Jazyk i uživatelské menu reagují na klik, ale layout je SSR — proto samostatné interaktivní ostrůvky *@
            <div class="ms-auto d-flex align-items-center gap-2">
                <LangSwitcher @rendermode="InteractiveServer" />
                <AuthorizeView>
                    <Authorized>
                        <AvatarDropdown @rendermode="InteractiveServer"
                                        UserName="@(context.User.Identity?.Name ?? "?")"
                                        ProfileHref=""
                                        SettingsHref="/account/change-password"
                                        LogoutHref="/account/logout" />
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
        <article class="content px-3 px-md-4">
            @Body
        </article>
    </main>
</div>
