@page "/review"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db

<PageTitle>@S["ReviewPageTitle"] — Metin2Bausia</PageTitle>

<h2>@S["ReviewHeading"]</h2>

@if (_error != null)
{
    <div class="alert alert-danger">@S["DbError", _error]</div>
}

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (!_items.Any())
{
    <div class="alert alert-success">@S["ReviewEmpty"]</div>
}
else
{
    <p class="text-muted">@S["ReviewTotal", _items.Count]</p>
    <table class="table table-sm">
        <thead class="table-dark">
            <tr>
                <th>@S["ColEntity"]</th>
                <th>@S["ColReason"]</th>
                <th>@S["ColRecord"]</th>
                <th>@S["Created"]</th>
                <th>@S["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr>
                    <td><code>@item.EntityTable</code></td>
                    <td><span class="badge bg-warning text-dark">@item.Reason</span></td>
                    <td><code class="small">@(item.EntityGuid?.ToString()[..8] ?? "—")</code></td>
                    <td>@item.CreatedAt.ToString("dd.MM.yy")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ResolveAsync(item)">
                            @S["MarkResolved"]
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<ManualReviewItem> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<ManualReviewItem>(
                @"SELECT ""Guid"", ""EntityTable"", ""EntityGuid"", ""Reason"", ""Status"", ""CreatedAt""
                  FROM ""ManualReviewQueue"" WHERE ""Status"" = 'pending' AND ""IsDeleted"" = FALSE
                  ORDER BY ""CreatedAt"" DESC")).ToList();
        }
        catch (Exception ex) { _error = LogError(ex); }
        finally { _loading = false; }
    }

    private async Task ResolveAsync(ManualReviewItem item)
    {
        try
        {
            await Db.ExecuteAsync(
                "UPDATE \"ManualReviewQueue\" SET \"Status\" = 'resolved', \"UpdatedAt\" = NOW() WHERE \"Guid\" = @Guid",
                new { item.Guid });
            _items.Remove(item);
        }
        catch (Exception ex) { _error = LogError(ex); }
    }
}
