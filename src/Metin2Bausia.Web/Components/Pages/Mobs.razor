@page "/mobs"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db

<PageTitle>@S["MobsPendingTitle"] — Metin2Bausia</PageTitle>

<h2>@S["MobsPendingHeading"]</h2>

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (!_mobs.Any())
{
    <div class="alert alert-info">@S["NoMobsPending"]</div>
}
else
{
    <p class="text-muted">@S["TotalMobs", _mobs.Count]</p>
    <div class="table-responsive">
        <table class="table table-hover table-sm">
            <thead class="table-dark">
                <tr>
                    <th>@S["ColVnum"]</th>
                    <th>@S["ColName"]</th>
                    <th>@S["Level"]</th>
                    <th>@S["Rank"]</th>
                    <th>@S["Source"]</th>
                    <th>@S["Confidence"]</th>
                    <th>@S["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mob in _mobs)
                {
                    <tr>
                        <td><code>@mob.Vnum</code></td>
                        <td><strong>@mob.Name</strong>@if (mob.LocaleName != null) { <small class="text-muted"> (@mob.LocaleName)</small> }</td>
                        <td>@mob.Level</td>
                        <td>@ContentLabels.Rank(mob.Rank)</td>
                        <td>@mob.SourceName</td>
                        <td>
                            <span class="badge @(mob.ConfidenceScore >= 80 ? "bg-success" : mob.ConfidenceScore >= 50 ? "bg-warning text-dark" : "bg-danger")">
                                @mob.ConfidenceScore
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-success me-1" disabled="@(_processing != null)"
                                    @onclick="() => ApproveAsync(mob)">✓</button>
                            <button class="btn btn-sm btn-danger" disabled="@(_processing != null)"
                                    @onclick="() => RejectAsync(mob)">✗</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ToastMessage Text="@ToastText" IsError="@ToastIsError" Stamp="@ToastStamp" />

@code {
    // Operátor do auditu — jméno přihlášeného uživatele místo natvrdo zapsaného 'admin'
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private List<PendingMob> _mobs = new();
    private Guid? _processing;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _mobs = (await Db.QueryAsync<PendingMob>(
                "SELECT \"Guid\", \"Vnum\", \"Name\", \"LocaleName\", \"Level\", \"Rank\", \"ContentStatus\", \"SourceName\", \"CreatedAt\", \"ConfidenceScore\" " +
                "FROM \"Mobs\" WHERE \"ContentStatus\" = 'pending' AND \"IsDeleted\" = false " +
                "ORDER BY \"ConfidenceScore\" DESC NULLS LAST, \"CreatedAt\" DESC LIMIT 200")).ToList();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { _loading = false; }
    }

    private async Task ApproveAsync(PendingMob mob)
    {
        _processing = mob.Guid;
        var op = await AuthState.OperatorNameAsync();
        try
        {
            await Db.ExecuteAsync(
                "UPDATE \"Mobs\" SET \"ContentStatus\" = 'approved', \"ApprovedAt\" = NOW(), \"ApprovedBy\" = @op, \"UpdatedAt\" = NOW() WHERE \"Guid\" = @Guid",
                new { mob.Guid, op });
            await Db.ExecuteAsync(
                "INSERT INTO \"ApprovalLog\" (\"Guid\", \"EntityTable\", \"EntityGuid\", \"EntityVnum\", \"EntityName\", \"Action\", \"Operator\", \"NewStatus\", \"CreatedAt\") VALUES (gen_random_uuid(), 'Mobs', @Guid, @Vnum, @Name, 'approved', @op, 'approved', NOW())",
                new { mob.Guid, mob.Vnum, mob.Name, op });
            ShowOk(S["MobApproved", mob.Name, mob.Vnum!]);
            _mobs.Remove(mob);
        }
        catch (Exception ex) { ShowError(ex); }
        finally { _processing = null; }
    }

    private async Task RejectAsync(PendingMob mob)
    {
        _processing = mob.Guid;
        var op = await AuthState.OperatorNameAsync();
        try
        {
            await Db.ExecuteAsync(
                "UPDATE \"Mobs\" SET \"ContentStatus\" = 'rejected', \"RejectedAt\" = NOW(), \"RejectedReason\" = 'manual_reject', \"UpdatedAt\" = NOW() WHERE \"Guid\" = @Guid",
                new { mob.Guid });
            await Db.ExecuteAsync(
                "INSERT INTO \"ApprovalLog\" (\"Guid\", \"EntityTable\", \"EntityGuid\", \"EntityVnum\", \"EntityName\", \"Action\", \"Operator\", \"NewStatus\", \"CreatedAt\") VALUES (gen_random_uuid(), 'Mobs', @Guid, @Vnum, @Name, 'rejected', @op, 'rejected', NOW())",
                new { mob.Guid, mob.Vnum, mob.Name, op });
            ShowOk(S["MobRejected", mob.Name]);
            _mobs.Remove(mob);
        }
        catch (Exception ex) { ShowError(ex); }
        finally { _processing = null; }
    }

}
