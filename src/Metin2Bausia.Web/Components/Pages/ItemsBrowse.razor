@page "/items/browse"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db

<PageTitle>@S["ItemDatabaseTitle"] — Metin2Bausia</PageTitle>

<h2>@S["ItemDatabaseTitle"] <span class="badge bg-secondary fs-6">@_total</span></h2>
<p class="text-muted mb-3">@S["ItemDatabaseIntro"]</p>

<div class="d-flex gap-2 align-items-center flex-wrap mb-3">
    <input class="form-control form-control-sm" style="max-width:240px"
           placeholder="@S["SearchNameVnum"]"
           @bind="_search" @bind:event="oninput" />
    <select class="form-select form-select-sm" style="max-width:160px" @bind="_typeFilter" @bind:after="ApplyFilter">
        <option value="">@S["AllTypes"]</option>
        @foreach (var t in _types)
        {
            <option value="@t">@ContentLabels.ItemType(t)</option>
        }
    </select>
    <select class="form-select form-select-sm" style="max-width:140px" @bind="_enabledFilter" @bind:after="ApplyFilter">
        <option value="">@S["All"]</option>
        <option value="true">@S["Enabled"]</option>
        <option value="false">@S["Disabled"]</option>
    </select>
    <span class="text-muted small ms-auto">@S["ShownOf", Filtered.Count(), _items.Count]</span>
</div>

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (!_items.Any())
{
    <div class="alert alert-info">@S["NoApprovedItems"]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-dark sticky-top">
                <tr>
                    <th style="width:70px">@S["ColVnum"]</th>
                    <th>@S["ColName"]</th>
                    <th style="width:80px">@S["Type"]</th>
                    <th style="width:90px">@S["Confidence"]</th>
                    <th style="width:80px">@S["On"]</th>
                    <th style="width:80px">@S["Source"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Filtered.Take(500))
                {
                    <tr class="@(item.IsEnabled ? "" : "opacity-50")">
                        <td><code class="small">@(item.Vnum?.ToString() ?? "—")</code></td>
                        <td>
                            <strong>@item.Name</strong>
                            @if (!string.IsNullOrEmpty(item.LocaleName))
                            {
                                <small class="text-muted ms-1">(@item.LocaleName)</small>
                            }
                        </td>
                        <td><span class="badge bg-secondary">@ContentLabels.ItemType(item.ItemType)</span></td>
                        <td>
                            @if (item.ConfidenceScore.HasValue)
                            {
                                <span class="badge @(item.ConfidenceScore >= 80 ? "bg-success" : item.ConfidenceScore >= 50 ? "bg-warning text-dark" : "bg-danger")">
                                    @item.ConfidenceScore
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.IsEnabled) { <span class="text-success">✓</span> }
                            else { <span class="text-muted">–</span> }
                        </td>
                        <td class="text-muted small">
                            @if (!string.IsNullOrEmpty(item.SourceUrl))
                            {
                                <a href="@item.SourceUrl" target="_blank" title="@item.SourceName">🔗</a>
                            }
                            else { @(item.SourceName ?? "—") }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Filtered.Count() > 500)
    {
        <div class="text-center text-muted small mt-2">@S["RowsLimited", 500]</div>
    }
}

<ToastMessage Text="@ToastText" IsError="@ToastIsError" Stamp="@ToastStamp" />

@code {
    private bool _loading = true;
    private int _total;
    private string _search = "";
    private string _typeFilter = "";
    private string _enabledFilter = "";

    private List<BrowseItem> _items = [];
    private List<string> _types = [];

    private IEnumerable<BrowseItem> Filtered =>
        _items.Where(i =>
            (string.IsNullOrWhiteSpace(_search) ||
             i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             (i.LocaleName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
             i.Vnum?.ToString() == _search) &&
            (string.IsNullOrEmpty(_typeFilter) || string.Equals(i.ItemType, _typeFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_enabledFilter) || i.IsEnabled.ToString().ToLower() == _enabledFilter));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _total = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"Items\" WHERE \"ContentStatus\" = 'approved' AND \"IsDeleted\" = FALSE");
            _items = (await Db.QueryAsync<BrowseItem>(
                @"SELECT ""Guid"", ""Vnum"", ""Name"", ""LocaleName"", ""ItemType"",
                         ""ConfidenceScore"", ""IsEnabled"", ""SourceName"", ""SourceUrl""
                  FROM ""Items""
                  WHERE ""ContentStatus"" = 'approved' AND ""IsDeleted"" = FALSE
                  ORDER BY ""Vnum"" ASC NULLS LAST
                  LIMIT 5000")).ToList();
            _types = _items.Where(i => !string.IsNullOrWhiteSpace(i.ItemType)).Select(i => i.ItemType!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).ToList();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { _loading = false; }
    }

    private void ApplyFilter() { }

    private class BrowseItem
    {
        public Guid Guid { get; set; }
        public int? Vnum { get; set; }
        public string Name { get; set; } = "";
        public string? LocaleName { get; set; }
        public string? ItemType { get; set; }
        public int? ConfidenceScore { get; set; }
        public bool IsEnabled { get; set; }
        public string? SourceName { get; set; }
        public string? SourceUrl { get; set; }
    }
}
