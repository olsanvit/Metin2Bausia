@page "/knowledge/monsters"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IDbService Db

<PageTitle>@S["KnMonstersTitle"] — Metin2Bausia</PageTitle>

<h2>@S["KnMonstersTitle"]</h2>
<p class="text-muted mb-3">@S["KnMonstersIntro"]</p>

@if (_error != null)
{
    <div class="alert alert-danger">@S["DbError", _error]</div>
}

<div class="toolbar mb-3 d-flex gap-2 align-items-center flex-wrap">
    <input class="form-control form-control-sm" style="max-width:240px"
           placeholder="@S["Search"]" @bind="_search" @bind:event="oninput" />
    <select class="form-select form-select-sm" style="max-width:160px" @bind="_element">
        <option value="">@S["KnAllElements"]</option>
        @foreach (var e in _elements)
        {
            <option value="@e">@e</option>
        }
    </select>
    <select class="form-select form-select-sm" style="max-width:200px" @bind="_location">
        <option value="">@S["KnAllLocations"]</option>
        @foreach (var l in _locations)
        {
            <option value="@l">@l</option>
        }
    </select>
    <select class="form-select form-select-sm" style="max-width:170px" @bind="_linked">
        <option value="">@S["All"]</option>
        <option value="true">@S["KnLinked"]</option>
        <option value="false">@S["KnNotLinked"]</option>
    </select>
    <span class="text-muted small ms-auto">@S["ShownOf", Filtered.Count(), _rows.Count]</span>
</div>

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (_rows.Count == 0)
{
    <div class="alert alert-info">@S["KnEmpty"]</div>
}
else
{
    <div class="table-responsive list-table">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-dark sticky-top">
                <tr>
                    <SortableHeader Field="Name" Label="@S["KnColName"]" @bind-SortBy="_sortBy" @bind-Ascending="_asc" />
                    <SortableHeader Field="Level" Label="@S["KnLevel"]" @bind-SortBy="_sortBy" @bind-Ascending="_asc" />
                    <th>@S["KnElement"]</th>
                    <th>@S["KnRace"]</th>
                    <th>@S["KnLocation"]</th>
                    <th style="width:90px">@S["KnMob"]</th>
                    <th style="width:50px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Shown)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td>@r.Level</td>
                        <td class="small">@r.Element</td>
                        <td class="small">@r.Race</td>
                        <td class="small text-muted">@r.Location</td>
                        <td>@if (r.MobVnum.HasValue) { <code>@r.MobVnum</code> }</td>
                        <td><a href="/knowledge/monsters/@r.Guid" class="btn btn-outline-secondary btn-sm py-0">→</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="list-cards">
        @foreach (var r in Shown)
        {
            <div class="list-card">
                <a class="list-card__main" href="/knowledge/monsters/@r.Guid">
                    <div class="list-card__title">@r.Name</div>
                    <div class="list-card__meta">
                        @if (r.Level != "") { <span class="small">Lv @r.Level</span> }
                        @if (r.Element != "") { <span class="badge bg-light text-dark">@r.Element</span> }
                        <span class="small text-muted">@r.Location</span>
                    </div>
                </a>
                <span class="text-muted">›</span>
            </div>
        }
    </div>

    @if (Filtered.Count() > MaxRows)
    {
        <p class="text-muted small mt-2">@S["KnTooMany", MaxRows]</p>
    }
}

@code {
    private const int MaxRows = 300;

    private bool _loading = true;
    private string? _error;
    private List<KnowledgeMonsterRow> _rows = [];
    private List<string> _elements = [], _locations = [];
    private string _search = "", _element = "", _location = "", _linked = "";
    private string _sortBy = "Level";
    private bool _asc = true;

    private IEnumerable<KnowledgeMonsterRow> Filtered => _rows.Where(r =>
        (string.IsNullOrEmpty(_search) || r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_element) || r.Element == _element) &&
        (string.IsNullOrEmpty(_location) || r.Location == _location) &&
        (string.IsNullOrEmpty(_linked) || r.MobVnum.HasValue.ToString().ToLower() == _linked));

    private IEnumerable<KnowledgeMonsterRow> Shown => (_sortBy == "Name"
        ? (_asc ? Filtered.OrderBy(r => r.Name) : Filtered.OrderByDescending(r => r.Name))
        : (_asc ? Filtered.OrderBy(r => r.LevelNumber ?? int.MaxValue).ThenBy(r => r.Name)
                : Filtered.OrderByDescending(r => r.LevelNumber ?? -1).ThenBy(r => r.Name))).Take(MaxRows);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _rows = (await Db.QueryAsync<KnowledgeMonsterRow>(
                @"SELECT ""Guid"", ""Name"", ""Element"", ""Race"", ""Level"", ""Location"", ""MobVnum""
                  FROM ""KnowledgeMonsters"" WHERE ""IsDeleted"" = FALSE")).ToList();
            _elements = _rows.Select(r => r.Element).Where(s => s != "").Distinct().Order().ToList();
            _locations = _rows.Select(r => r.Location).Where(s => s != "").Distinct().Order().ToList();
        }
        catch (Exception ex) { _error = LogError(ex); }
        finally { _loading = false; }
    }
}
