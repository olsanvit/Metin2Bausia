@inject KnowledgeLinkService Links

@* Ruční spárování wiki záznamu s naším mobem — automaticky to nejde, jména na wiki jsou anglická *@
<div class="card mb-3">
    <div class="card-header small d-flex justify-content-between align-items-center">
        <strong>@S["KnMobLink"]</strong>
        <a href="/knowledge/link?kind=@Kind.ToString().ToLowerInvariant()&id=@RowGuid" class="small">@S["KnFindCandidates"]</a>
    </div>
    <div class="card-body small d-grid gap-2">
        @if (_mobGuid.HasValue)
        {
            <div>
                <a href="/manage/mobs/@_mobGuid">@(_mobName ?? S["KnMob"])</a>
                <code class="ms-1">@_vnum</code>
            </div>
        }
        else if (_vnum.HasValue)
        {
            <div class="text-warning">@S["KnMobMissing", _vnum]</div>
        }
        <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="vnum" min="1" @bind="_input" />
            <button class="btn btn-outline-primary" @onclick="SaveAsync">@S["Save"]</button>
            @if (_vnum.HasValue)
            {
                <button class="btn btn-outline-secondary" @onclick="ClearAsync">@S["KnUnlink"]</button>
            }
        </div>
    </div>
</div>

<ToastMessage Text="@ToastText" IsError="@ToastIsError" Stamp="@ToastStamp" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter, EditorRequired] public KnowledgeKind Kind { get; set; }
    [Parameter, EditorRequired] public Guid RowGuid { get; set; }
    [Parameter] public int? MobVnum { get; set; }
    [Parameter] public string? MobName { get; set; }
    [Parameter] public Guid? MobGuid { get; set; }

    private int? _vnum, _input;
    private string? _mobName;
    private Guid? _mobGuid;

    protected override void OnInitialized()
    {
        _vnum = _input = MobVnum;
        _mobName = MobName;
        _mobGuid = MobGuid;
    }

    private async Task SaveAsync()
    {
        try
        {
            var (result, mob) = await Links.LinkAsync(Kind, RowGuid, _input ?? 0, await AuthState.OperatorNameAsync());
            switch (result)
            {
                case LinkResult.Ok:
                    (_vnum, _mobName, _mobGuid) = (mob!.Vnum, mob.Label, mob.Guid);
                    ShowOk(S["Saved"]);
                    break;
                case LinkResult.InvalidVnum: ShowProblem(S["KnVnumInvalid"]); break;
                case LinkResult.MobNotFound: ShowProblem(S["KnMobMissing", _input!]); break;
                case LinkResult.WrongMobType: ShowProblem(S[Kind == KnowledgeKind.Stone ? "KnNeedStone" : "KnNoStone", _input!]); break;
                default: ShowProblem(S["NotFound"]); break;
            }
        }
        catch (Exception ex) { ShowError(ex); }
    }

    private async Task ClearAsync()
    {
        try
        {
            await Links.UnlinkAsync(Kind, RowGuid, await AuthState.OperatorNameAsync());
            (_vnum, _input, _mobName, _mobGuid) = (null, null, null, null);
            ShowOk(S["Saved"]);
        }
        catch (Exception ex) { ShowError(ex); }
    }
}
