@page "/reports"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db

<PageTitle>@S["ReportsPageTitle"] — Metin2Bausia</PageTitle>

<h2>@S["ReportsHeading"]</h2>

@if (_error != null)
{
    <div class="alert alert-danger">@S["DbError", _error]</div>
}

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (!_runs.Any())
{
    <div class="alert alert-info">@S["NoAgentRuns"]</div>
}
else
{
    <table class="table table-sm table-hover">
        <thead class="table-dark">
            <tr>
                <th>@S["ColAgent"]</th>
                <th>@S["ColMode"]</th>
                <th>@S["ColReadiness"]</th>
                <th>@S["ColResult"]</th>
                <th>@S["ColStarted"]</th>
                <th>@S["ColDuration"]</th>
                <th class="text-end">@S["ColNew"]</th>
                <th class="text-end">@S["ColChanged"]</th>
                <th class="text-end">@S["ColFailed"]</th>
                <th>@S["ColHighlights"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in _runs)
            {
                <tr>
                    <td>@run.AgentName</td>
                    <td class="small text-muted">@run.RunMode</td>
                    <td><span class="badge @(run.ReadinessStatus == "ready" ? "bg-success" : "bg-secondary")">@run.ReadinessStatus</span></td>
                    <td><span class="badge @(run.Success == true ? "bg-success" : "bg-danger")">@(run.Success == true ? S["BadgeOk"] : S["BadgeError"])</span></td>
                    <td>@run.CreatedAt.ToString("dd.MM.yy HH:mm")</td>
                    <td>@Duration(run)</td>
                    <td class="text-end">@run.EntitiesInserted</td>
                    <td class="text-end">@run.EntitiesUpdated</td>
                    <td class="text-end">@run.EntitiesFailed</td>
                    <td><small class="text-muted">@TruncateHighlights(run.Highlights)</small></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<AgentRunReport> _runs = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _runs = (await Db.QueryAsync<AgentRunReport>(
                "SELECT * FROM \"AgentRunReports\" ORDER BY \"CreatedAt\" DESC LIMIT 50")).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    // DurationMs je jediný zdroj délky běhu — sloupce s časem začátku/konce v tabulce nejsou
    private static string Duration(AgentRunReport run)
    {
        if (run.DurationMs is not > 0) return "-";
        var span = TimeSpan.FromMilliseconds(run.DurationMs.Value);
        return span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes}m {span.Seconds}s" : $"{(int)span.TotalSeconds}s";
    }

    private static string TruncateHighlights(string? highlights)
    {
        if (string.IsNullOrEmpty(highlights)) return "";
        return highlights.Length > 80 ? highlights[..80] + "…" : highlights;
    }
}
