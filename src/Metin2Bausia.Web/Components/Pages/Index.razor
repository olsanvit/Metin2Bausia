@page "/"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db

<PageTitle>@S["DashboardTitle"] — Metin2Bausia</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="mb-0">@S["AdminTitle"]</h1>
    <a href="/stats" class="btn btn-outline-secondary btn-sm">@S["NavStats"]</a>
</div>

@if (_error != null)
{
    <div class="alert alert-danger">@S["DbError", _error]</div>
}

@if (_loading)
{
    <p>@S["LoadingStats"]</p>
}
else
{
    @* ── Urgentní fronta ──────────────────────────────────── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="/items" class="text-decoration-none">
                <div class="card @(_pendingItems > 0 ? "text-bg-warning" : "text-bg-light") h-100">
                    <div class="card-body">
                        <div class="card-title small">@S["CardItemsPending"]</div>
                        <div class="fs-2 fw-bold">@_pendingItems</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/mobs" class="text-decoration-none">
                <div class="card @(_pendingMobs > 0 ? "text-bg-warning" : "text-bg-light") h-100">
                    <div class="card-body">
                        <div class="card-title small">@S["CardMobsPending"]</div>
                        <div class="fs-2 fw-bold">@_pendingMobs</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/manage/items" class="text-decoration-none">
                <div class="card text-bg-success h-100">
                    <div class="card-body">
                        <div class="card-title small">@S["CardItemsApproved"]</div>
                        <div class="fs-2 fw-bold">@_approvedItems</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/review" class="text-decoration-none">
                <div class="card @(_manualReview > 0 ? "text-bg-danger" : "text-bg-light") h-100">
                    <div class="card-body">
                        <div class="card-title small">@S["CardManualReview"]</div>
                        <div class="fs-2 fw-bold">@_manualReview</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    @* ── Agent stav ───────────────────────────────────────── *@
    @if (_recentRuns.Any())
    {
        var lastRun = _recentRuns.First();
        var isHealthy = lastRun.Success == true;
        <div class="alert @(isHealthy ? "alert-success" : "alert-danger") d-flex align-items-center gap-2 mb-3">
            <span style="font-size:1.2rem">@(isHealthy ? "✅" : "❌")</span>
            <div>
                <strong>@S["LastAgentRun", lastRun.AgentName ?? "—"]</strong>
                <span class="ms-2 text-muted small">@lastRun.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                — <strong>@(isHealthy ? S["RunSuccess"] : S["RunFailure"])</strong>
                <span class="ms-2">@S["RunNewUpdated", lastRun.EntitiesInserted ?? 0, lastRun.EntitiesUpdated ?? 0]</span>
                @if (lastRun.BlockerCategory != null)
                {
                    <span class="ms-2">· @S["BlockerLabel"]: <strong>@lastRun.BlockerCategory</strong></span>
                }
            </div>
        </div>
    }

    <h5 class="mb-2">@S["RecentRuns"]</h5>
    @if (_recentRuns.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead class="table-secondary">
                    <tr>
                        <th>@S["ColAgent"]</th>
                        <th>@S["ColResult"]</th>
                        <th>@S["ColStarted"]</th>
                        <th class="text-end">@S["ColNew"]</th>
                        <th class="text-end">@S["ColChanged"]</th>
                        <th class="text-end">@S["ColFailed"]</th>
                        <th>@S["ColHighlights"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in _recentRuns)
                    {
                        <tr>
                            <td class="fw-semibold">@run.AgentName</td>
                            <td><span class="badge @(run.Success == true ? "bg-success" : "bg-danger")">@(run.Success == true ? S["BadgeOk"] : S["BadgeError"])</span></td>
                            <td class="text-muted small">@run.CreatedAt.ToString("dd.MM HH:mm")</td>
                            <td class="text-end small">@(run.EntitiesInserted ?? 0)</td>
                            <td class="text-end small">@(run.EntitiesUpdated ?? 0)</td>
                            <td class="text-end small">@(run.EntitiesFailed ?? 0)</td>
                            <td class="text-muted small" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @run.Highlights
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <a href="/reports" class="btn btn-outline-secondary btn-sm">@S["ShowAllReports"]</a>
    }
    else
    {
        <p class="text-muted">@S["NoAgentRuns"]</p>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private int _pendingItems, _pendingMobs, _approvedItems, _manualReview;
    private List<AgentRunReport> _recentRuns = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _pendingItems = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"Items\" WHERE \"ContentStatus\" = 'pending' AND \"IsDeleted\" = false");
            _pendingMobs = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"Mobs\" WHERE \"ContentStatus\" = 'pending' AND \"IsDeleted\" = false");
            _approvedItems = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"Items\" WHERE \"ContentStatus\" = 'approved' AND \"IsDeleted\" = false");
            _manualReview = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"ManualReviewQueue\" WHERE \"Status\" = 'pending' AND \"IsDeleted\" = FALSE");
            _recentRuns = (await Db.QueryAsync<AgentRunReport>(
                "SELECT * FROM \"AgentRunReports\" ORDER BY \"CreatedAt\" DESC LIMIT 5")).ToList();
        }
        catch (Exception ex) { _error = LogError(ex); }
        finally { _loading = false; }
    }
}
