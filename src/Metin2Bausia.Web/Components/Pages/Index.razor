@page "/"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db
@inject GameServerStatusService GameServer

<PageTitle>@S["DashboardTitle"] — Metin2Bausia</PageTitle>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h1 class="mb-0">@S["OverviewTitle"]</h1>
    <div class="d-flex flex-wrap gap-2">
        <a href="/manage/items" class="btn btn-outline-secondary btn-sm"><i class="bi bi-box-seam me-1"></i>@S["Nav2ManageItems"]</a>
        <a href="/manage/mobs" class="btn btn-outline-secondary btn-sm"><i class="bi bi-bug me-1"></i>@S["Nav2ManageMobs"]</a>
        <a href="/manage/maps" class="btn btn-outline-secondary btn-sm"><i class="bi bi-map me-1"></i>@S["Nav2ManageMaps"]</a>
        <a href="/stats" class="btn btn-outline-secondary btn-sm">@S["NavStats"]</a>
    </div>
</div>

@if (_error != null)
{
    <div class="alert alert-danger">@S["DbError", _error]</div>
}

@if (_loading)
{
    <p>@S["LoadingStats"]</p>
}
else
{
    @* ── Urgentní fronta ──────────────────────────────────── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="/items" class="text-decoration-none">
                <div class="card @(_pendingItems > 0 ? "text-bg-warning" : "text-bg-light") h-100">
                    <div class="card-body">
                        <div class="card-title small">@S["CardItemsPending"]</div>
                        <div class="fs-2 fw-bold">@_pendingItems</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/mobs" class="text-decoration-none">
                <div class="card @(_pendingMobs > 0 ? "text-bg-warning" : "text-bg-light") h-100">
                    <div class="card-body">
                        <div class="card-title small">@S["CardMobsPending"]</div>
                        <div class="fs-2 fw-bold">@_pendingMobs</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/manage/items" class="text-decoration-none">
                <div class="card text-bg-success h-100">
                    <div class="card-body">
                        <div class="card-title small">@S["CardItemsApproved"]</div>
                        <div class="fs-2 fw-bold">@_approvedItems</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/review" class="text-decoration-none">
                <div class="card @(_manualReview > 0 ? "text-bg-danger" : "text-bg-light") h-100">
                    <div class="card-body">
                        <div class="card-title small">@S["CardManualReview"]</div>
                        <div class="fs-2 fw-bold">@_manualReview</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    @* ── Herní server a noční dávky ────────────────────────── *@
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-hdd-network me-1"></i>@S["GameServerTitle"]</div>
                <div class="card-body">
                    @if (_server == null)
                    {
                        <span class="text-muted small">@S["Loading"]</span>
                    }
                    else
                    {
                        <span class="badge fs-6 @ServerBadge(_server.State)">@S["GameServer" + _server.State]</span>
                        @if (_server.State == GameServerState.NotDeployed)
                        {
                            <p class="small text-muted mt-2 mb-0">@S["GameServerNotDeployedHint"]</p>
                        }
                        <ul class="list-unstyled small mt-2 mb-0">
                            @foreach (var e in _server.Endpoints)
                            {
                                <li><i class="bi @(e.Open ? "bi-check-circle text-success" : "bi-x-circle text-danger") me-1"></i>@e.Name (@e.Port)</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-moon-stars me-1"></i>@S["BatchRunsTitle"]</div>
                <div class="card-body p-0">
                    @if (_batches.Count == 0)
                    {
                        <p class="small text-muted p-3 mb-0">@S["BatchRunsEmpty"]</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var b in _batches)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <span class="badge @BatchBadge(b.Result)">@b.Result</span>
                                        <strong>@b.Name</strong>
                                        <span class="text-muted ms-auto">@b.StartedAt.ToLocalTime().ToString("dd.MM HH:mm")@(b.FinishedAt is { } f ? $" – {f.ToLocalTime():HH:mm}" : "")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(b.Summary) && b.Result is not "ok")
                                    {
                                        <div class="text-muted text-break">@b.Summary</div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Agent stav — dokud agent neexistuje, jen poznámka místo prázdných tabulek (Vítek 17. 10.) *@
    @if (!_recentRuns.Any())
    {
        <p class="text-muted small"><i class="bi bi-robot me-1"></i>@S["AgentNotConfigured"]</p>
    }
    else
    {
    @if (_recentRuns.Any())
    {
        var lastRun = _recentRuns.First();
        var isHealthy = lastRun.Success == true;
        <div class="alert @(isHealthy ? "alert-success" : "alert-danger") d-flex align-items-center gap-2 mb-3">
            <span style="font-size:1.2rem">@(isHealthy ? "✅" : "❌")</span>
            <div>
                <strong>@S["LastAgentRun", lastRun.AgentName ?? "—"]</strong>
                <span class="ms-2 text-muted small">@lastRun.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                — <strong>@(isHealthy ? S["RunSuccess"] : S["RunFailure"])</strong>
                <span class="ms-2">@S["RunNewUpdated", lastRun.EntitiesInserted ?? 0, lastRun.EntitiesUpdated ?? 0]</span>
                @if (lastRun.BlockerCategory != null)
                {
                    <span class="ms-2">· @S["BlockerLabel"]: <strong>@lastRun.BlockerCategory</strong></span>
                }
            </div>
        </div>
    }

    <h5 class="mb-2">@S["RecentRuns"]</h5>
    @if (_recentRuns.Any())
    {
        <div class="table-responsive list-table">
            <table class="table table-sm table-hover">
                <thead class="table-secondary">
                    <tr>
                        <th>@S["ColAgent"]</th>
                        <th>@S["ColResult"]</th>
                        <th>@S["ColStarted"]</th>
                        <th class="text-end">@S["ColNew"]</th>
                        <th class="text-end">@S["ColChanged"]</th>
                        <th class="text-end">@S["ColFailed"]</th>
                        <th>@S["ColHighlights"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in _recentRuns)
                    {
                        <tr>
                            <td class="fw-semibold">@run.AgentName</td>
                            <td><span class="badge @(run.Success == true ? "bg-success" : "bg-danger")">@(run.Success == true ? S["BadgeOk"] : S["BadgeError"])</span></td>
                            <td class="text-muted small">@run.CreatedAt.ToString("dd.MM HH:mm")</td>
                            <td class="text-end small">@(run.EntitiesInserted ?? 0)</td>
                            <td class="text-end small">@(run.EntitiesUpdated ?? 0)</td>
                            <td class="text-end small">@(run.EntitiesFailed ?? 0)</td>
                            <td class="text-muted small" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @run.Highlights
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Sedm sloupců se na mobil nevejde — běh se skládá na kartu, highlights se zalomí celé *@
        <div class="list-cards">
            @foreach (var run in _recentRuns)
            {
                <div class="list-card">
                    <div class="list-card__main">
                        <div class="list-card__title">@run.AgentName</div>
                        <div class="list-card__meta">
                            <span class="badge @(run.Success == true ? "bg-success" : "bg-danger")">
                                @(run.Success == true ? S["BadgeOk"] : S["BadgeError"])
                            </span>
                            <span class="small text-muted">@run.CreatedAt.ToString("dd.MM HH:mm")</span>
                            <span class="small text-muted">@S["RunNewUpdated", run.EntitiesInserted ?? 0, run.EntitiesUpdated ?? 0]</span>
                            @if ((run.EntitiesFailed ?? 0) > 0)
                            {
                                <span class="badge bg-warning text-dark">@S["ColFailed"] @run.EntitiesFailed</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(run.Highlights))
                        {
                            <div class="small text-muted">@run.Highlights</div>
                        }
                    </div>
                </div>
            }
        </div>

        <a href="/reports" class="btn btn-outline-secondary btn-sm mt-3">@S["ShowAllReports"]</a>
    }
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private int _pendingItems, _pendingMobs, _approvedItems, _manualReview;
    private List<AgentRunReport> _recentRuns = new();
    private List<BatchRunRow> _batches = [];
    private GameServerStatus? _server;

    private static string ServerBadge(GameServerState s) => s switch
    {
        GameServerState.Running => "bg-success",
        GameServerState.Partial => "bg-warning text-dark",
        GameServerState.Down => "bg-danger",
        _ => "bg-secondary",
    };

    private static string BatchBadge(string r) => r switch
    {
        "ok" => "bg-success",
        "running" => "bg-info text-dark",
        "check" => "bg-warning text-dark",
        _ => "bg-danger",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _pendingItems = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"Items\" WHERE \"ContentStatus\" = 'pending' AND \"IsDeleted\" = false");
            _pendingMobs = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"Mobs\" WHERE \"ContentStatus\" = 'pending' AND \"IsDeleted\" = false");
            _approvedItems = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"Items\" WHERE \"ContentStatus\" = 'approved' AND \"IsDeleted\" = false");
            _manualReview = await Db.QueryFirstOrDefaultAsync<int>(
                "SELECT COUNT(*) FROM \"ManualReviewQueue\" WHERE \"Status\" = 'pending' AND \"IsDeleted\" = FALSE");
            _recentRuns = (await Db.QueryAsync<AgentRunReport>(
                "SELECT * FROM \"AgentRunReports\" ORDER BY \"CreatedAt\" DESC LIMIT 5")).ToList();
            // Bez migrace 09 tabulka chybí — přehled se kvůli tomu nesmí rozbít
            if (await Db.QueryFirstOrDefaultAsync<bool>(@"SELECT to_regclass('""BatchRuns""') IS NOT NULL"))
                _batches = (await Db.QueryAsync<BatchRunRow>(
                    @"SELECT ""Name"", ""StartedAt"", ""FinishedAt"", ""Result"", ""Summary"" FROM ""BatchRuns""
                      ORDER BY ""StartedAt"" DESC LIMIT 5")).ToList();
        }
        catch (Exception ex) { _error = LogError(ex); }
        finally { _loading = false; }

        // Ping portů až po vykreslení čísel z DB — nedostupný server nesmí brzdit načtení přehledu
        try { _server = await GameServer.GetAsync(); }
        catch (Exception ex) { LogError(ex); _server = new(GameServerState.Down, []); }
    }
}
