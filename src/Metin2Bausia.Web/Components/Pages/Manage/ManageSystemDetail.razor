@page "/manage/systems/{Guid:guid}"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db
@inject NavigationManager Nav

<PageTitle>@(_sys?.SystemName ?? S["SystemDetailTitle"]) — Metin2Bausia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/manage/systems" class="btn btn-outline-secondary btn-sm">@S["BackToSystems"]</a>
    @if (_sys != null)
    {
        <span class="badge @StatusClass(_sys.ContentStatus)">@_sys.ContentStatus</span>
        <span class="badge @(_sys.IsEnabled ? "bg-success" : "bg-secondary")">
            @(_sys.IsEnabled ? S["On"] : S["Off"])
        </span>
        @if (_sys.Complexity != null)
        {
            <span class="badge @ComplexityBadge(_sys.Complexity)">@_sys.Complexity</span>
        }
    }
</div>

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (_sys == null)
{
    <div class="alert alert-danger">@S["SystemNotFound"]</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><strong>@S["BasicInfo"]</strong></div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small">@S["SystemName"]</label>
                            <input class="form-control form-control-sm" @bind="_editName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@S["Category"]</label>
                            <select class="form-select form-select-sm" @bind="_editCategory">
                                <option value="">—</option>
                                <option value="crafting">@S["CatCrafting"]</option>
                                <option value="enchant">@S["CatEnchant"]</option>
                                <option value="mount">@S["CatMount"]</option>
                                <option value="pet">@S["CatPet"]</option>
                                <option value="pvp">PvP</option>
                                <option value="guild">Guild</option>
                                <option value="quest">Quest</option>
                                <option value="economy">@S["CatEconomy"]</option>
                                <option value="drop">@S["CatDrop"]</option>
                                <option value="event">@S["CatEvent"]</option>
                                <option value="skill">@S["CatSkill"]</option>
                                <option value="other">@S["CatOther"]</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small">@S["Complexity"]</label>
                            <select class="form-select form-select-sm" @bind="_editComplexity">
                                <option value="">—</option>
                                <option value="low">@S["ComplexityLow"]</option>
                                <option value="medium">@S["ComplexityMedium"]</option>
                                <option value="high">@S["ComplexityHigh"]</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@S["SourceServer"]</label>
                            <input class="form-control form-control-sm" @bind="_editSourceServer" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">@S["Description"]</label>
                        <textarea class="form-control form-control-sm" rows="3" @bind="_editDescription"></textarea>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_sys.Implementation))
            {
                <div class="card mb-3">
                    <div class="card-header"><strong>@S["Implementation"]</strong></div>
                    <div class="card-body">
                        <pre class="small mb-0" style="white-space:pre-wrap;">@_sys.Implementation</pre>
                    </div>
                </div>
            }

            @if (_sys.SourceName != null)
            {
                <div class="card mb-3">
                    <div class="card-header"><strong>@S["DataSource"]</strong></div>
                    <div class="card-body small">
                        <strong>@_sys.SourceName</strong>
                        @if (_sys.SourceUrl != null)
                        { <a href="@_sys.SourceUrl" target="_blank" class="ms-2">@_sys.SourceUrl</a> }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><strong>@S["DataQuality"]</strong></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>@S["FinalScore"]</span>
                        <strong>@(_sys.FinalScore?.ToString("F2") ?? "—")</strong>
                    </div>
                    <hr class="my-2" />
                    <div class="small text-muted">
                        @S["Created"]: @_sys.CreatedAt.ToString("dd.MM.yyyy")<br />
                        @S["Updated"]: @_sys.UpdatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><strong>@S["Actions"]</strong></div>
                <div class="card-body d-grid gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsync">@S["Save"]</button>
                    <div class="d-flex gap-1">
                        <button class="btn btn-success btn-sm flex-fill" @onclick='() => SetStatusAsync("approved")'
                                disabled="@(_sys.ContentStatus == "approved")">@S["Approve"]</button>
                        <button class="btn btn-danger btn-sm flex-fill" @onclick='() => SetStatusAsync("rejected")'
                                disabled="@(_sys.ContentStatus == "rejected")">@S["Reject"]</button>
                    </div>
                    <button class="btn @(_sys.IsEnabled ? "btn-outline-secondary" : "btn-outline-success") btn-sm"
                            @onclick="ToggleEnabledAsync">
                        @(_sys.IsEnabled ? S["ToggleOff"] : S["ToggleOn"])
                    </button>
                </div>
            </div>

            <div class="small text-muted">GUID: <code class="small">@_sys.Guid</code></div>
        </div>
    </div>
}

@if (_msg != null)
{
    <div class="toast-msg @(_isErr ? "toast-err" : "toast-ok") mt-3">@_msg</div>
}

@code {
    [Parameter] public Guid Guid { get; set; }

    // Operátor do auditu — bez toho by v ApprovalLog nebylo poznat, kdo změnu provedl
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private DetailSystem? _sys;
    private string _editName = "";
    private string? _editCategory;
    private string? _editDescription;
    private string? _editComplexity;
    private string? _editSourceServer;
    private string? _msg;
    private bool _isErr;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sys = await Db.QueryFirstOrDefaultAsync<DetailSystem>(
                @"SELECT ""Guid"", ""SystemName"", ""Category"", ""Description"",
                         ""Implementation"", ""Complexity"", ""SourceServer"",
                         ""SourceName"", ""SourceUrl"", ""ContentStatus"", ""IsEnabled"",
                         ""FinalScore"", ""CreatedAt"", ""UpdatedAt""
                  FROM ""Systems"" WHERE ""Guid"" = @g AND ""IsDeleted"" = FALSE",
                new { g = Guid });

            if (_sys != null)
            {
                _editName = _sys.SystemName;
                _editCategory = _sys.Category;
                _editDescription = _sys.Description;
                _editComplexity = _sys.Complexity;
                _editSourceServer = _sys.SourceServer;
            }
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_sys == null) return;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Systems"" SET ""SystemName"" = @n, ""Category"" = @c,
                         ""Description"" = @d, ""Complexity"" = @cx, ""SourceServer"" = @ss, ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new { n = _editName, c = _editCategory, d = _editDescription, cx = _editComplexity, ss = _editSourceServer, g = _sys.Guid });
            _sys.SystemName = _editName;
            _sys.Category = _editCategory;
            _sys.Description = _editDescription;
            _sys.Complexity = _editComplexity;
            _sys.SourceServer = _editSourceServer;
            _msg = S["Saved"];
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private async Task SetStatusAsync(string status)
    {
        if (_sys == null) return;
        var op = await AuthState.OperatorNameAsync();
        var prev = _sys.ContentStatus;
        try
        {
            // Razítko schválení/zamítnutí patří k záznamu — seznamové stránky ho zapisují taky
            await Db.ExecuteAsync(
                @"UPDATE ""Systems"" SET ""ContentStatus"" = @s,
                         ""ApprovedAt""  = CASE WHEN @s = 'approved' THEN NOW() ELSE ""ApprovedAt"" END,
                         ""ApprovedBy""  = CASE WHEN @s = 'approved' THEN @op   ELSE ""ApprovedBy"" END,
                         ""RejectedAt""  = CASE WHEN @s = 'rejected' THEN NOW() ELSE ""RejectedAt"" END,
                         ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new { s = status, op, g = _sys.Guid });
            await Db.ExecuteAsync(
                @"INSERT INTO ""ApprovalLog"" (""Guid"", ""EntityTable"", ""EntityGuid"", ""EntityVnum"", ""EntityName"", ""Action"", ""Operator"", ""PrevStatus"", ""NewStatus"", ""CreatedAt"")
                  VALUES (gen_random_uuid(), 'Systems', @g, @vnum, @name, @s, @op, @prev, @s, NOW())",
                new { g = _sys.Guid, vnum = (int?)null, name = _sys.SystemName, s = status, op, prev });
            _sys.ContentStatus = status;
            _msg = S["StatusChanged", status];
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private async Task ToggleEnabledAsync()
    {
        if (_sys == null) return;
        var newVal = !_sys.IsEnabled;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Systems"" SET ""IsEnabled"" = @v, ""UpdatedAt"" = NOW() WHERE ""Guid"" = @g",
                new { v = newVal, g = _sys.Guid });
            _sys.IsEnabled = newVal;
            _msg = newVal ? S["MsgOn"] : S["MsgOff"];
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private static string StatusClass(string? s) => s switch
    {
        "approved" => "bg-success",
        "pending"  => "bg-warning text-dark",
        "rejected" => "bg-danger",
        _          => "bg-secondary"
    };

    private static string ComplexityBadge(string? c) => c switch
    {
        "low"    => "bg-success",
        "medium" => "bg-warning text-dark",
        "high"   => "bg-danger",
        _        => "bg-secondary"
    };
}
