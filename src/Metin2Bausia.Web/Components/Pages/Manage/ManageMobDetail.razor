@page "/manage/mobs/{Guid:guid}"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db
@inject NavigationManager Nav

<PageTitle>@(_mob?.Name ?? S["MobDetailTitle"]) — Metin2Bausia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/manage/mobs" class="btn btn-outline-secondary btn-sm">@S["BackToMobs"]</a>
    @if (_mob != null)
    {
        <span class="badge @StatusClass(_mob.ContentStatus)">@_mob.ContentStatus</span>
        <span class="badge @(_mob.IsEnabled ? "bg-success" : "bg-secondary")">
            @(_mob.IsEnabled ? S["On"] : S["Off"])
        </span>
    }
</div>

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (_mob == null)
{
    <div class="alert alert-danger">@S["MobNotFound"]</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Základní info -->
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@S["BasicInfo"]</strong>
                    <code class="small">vnum @_mob.Vnum</code>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small">@S["InternalName"]</label>
                            <input class="form-control form-control-sm" @bind="_editName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@S["LocaleName"]</label>
                            <input class="form-control form-control-sm" @bind="_editLocaleName" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small">@S["Type"]</label>
                            <select class="form-select form-select-sm" @bind="_editMobType">
                                <option value="">—</option>
                                <option value="monster">@S["MobTypeMonster"]</option>
                                <option value="npc">NPC</option>
                                <option value="metin">Metin</option>
                                <option value="boss">Boss</option>
                                <option value="chest">@S["MobTypeChest"]</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@S["Rank"]</label>
                            <select class="form-select form-select-sm" @bind="_editRank">
                                <option value="">—</option>
                                <option value="pawn">@S["RankPawn"]</option>
                                <option value="knight">@S["RankKnight"]</option>
                                <option value="super_knight">@S["RankSuperKnight"]</option>
                                <option value="boss">Boss</option>
                                <option value="king">@S["RankKing"]</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@S["Level"]</label>
                            <input class="form-control form-control-sm" type="number" value="@_mob.Level" readonly />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">@S["Description"]</label>
                        <textarea class="form-control form-control-sm" rows="3" @bind="_editDescription"></textarea>
                    </div>
                </div>
            </div>

            <!-- Statistiky -->
            <div class="card mb-3">
                <div class="card-header"><strong>@S["CombatStats"]</strong></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3 text-center">
                            <div class="small text-muted">@S["MaxHp"]</div>
                            <div class="fw-bold">@(_mob.MaxHp?.ToString("N0") ?? "—")</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="small text-muted">@S["Exp"]</div>
                            <div class="fw-bold">@(_mob.Exp?.ToString("N0") ?? "—")</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="small text-muted">@S["Attack"]</div>
                            <div class="fw-bold">@(_mob.Atk ?? 0)</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="small text-muted">@S["Defense"]</div>
                            <div class="fw-bold">@(_mob.Def ?? 0)</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="small text-muted">@S["MagicAttack"]</div>
                            <div class="fw-bold">@(_mob.MagicAtk ?? 0)</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="small text-muted">@S["MagicDefense"]</div>
                            <div class="fw-bold">@(_mob.MagicDef ?? 0)</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="small text-muted">@S["AttackSpeed"]</div>
                            <div class="fw-bold">@(_mob.AttackSpeed ?? 0)</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="small text-muted">@S["MoveSpeed"]</div>
                            <div class="fw-bold">@(_mob.MoveSpeed ?? 0)</div>
                        </div>
                    </div>

                    <hr />
                    <div class="row g-2">
                        <div class="col-md-4 text-center">
                            <div class="small text-muted">@S["GoldMinMax"]</div>
                            <div class="fw-bold">@(_mob.GoldMin?.ToString("N0") ?? "0") – @(_mob.GoldMax?.ToString("N0") ?? "0")</div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="small text-muted">@S["GoldChance"]</div>
                            <div class="fw-bold">@(_mob.GoldDropRate ?? 0) %</div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="small text-muted">@S["AggressiveSight"]</div>
                            <div class="fw-bold">@(_mob.AggressiveSight ?? 0)</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Dropy z mob_drop_item.txt — typy kill/limit odkazují item jménem, vnum se proto dohledává *@
            <div class="card mb-3">
                <div class="card-header"><strong>@S["DropsTitle"]</strong></div>
                <div class="card-body p-0">
                    @if (_drops.Count == 0)
                    {
                        <p class="text-muted small m-3">@S["DropsNone"]</p>
                    }
                    else
                    {
                        @foreach (var g in _drops)
                        {
                            <div class="px-3 pt-2 small">
                                <span class="badge bg-secondary">@g.Type</span>
                                <span class="text-muted ms-1">@g.Group</span>
                                @if (!string.IsNullOrEmpty(g.KillDrop)) { <span class="ms-2">@S["DropKillDrop"]: @g.KillDrop</span> }
                                @if (!string.IsNullOrEmpty(g.LevelLimit)) { <span class="ms-2">@S["DropLevelLimit"]: @g.LevelLimit</span> }
                            </div>
                            <table class="table table-sm mb-2">
                                <thead><tr><th>@S["DropItem"]</th><th class="text-end">@S["DropCount"]</th><th class="text-end">@S["DropChance"]</th></tr></thead>
                                <tbody>
                                @foreach (var it in g.Items)
                                {
                                    <tr>
                                        <td>
                                            @if (it.Vnum is int v && _itemNames.TryGetValue(v, out var item))
                                            { <a href="/manage/items/@item.Guid">@item.Label</a> <code class="small text-muted ms-1">@v</code> }
                                            else if (it.Vnum is int v2)
                                            { <code class="small">@v2</code> }
                                            else
                                            { <span class="text-muted">@(it.ItemName ?? "?") (@S["DropUnresolved"])</span> }
                                        </td>
                                        <td class="text-end">@it.Count</td>
                                        <td class="text-end">@it.Pct.ToString("0.###") %</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            </div>

            @if (_mob.SourceName != null)
            {
                <div class="card mb-3">
                    <div class="card-header"><strong>@S["DataSource"]</strong></div>
                    <div class="card-body small">
                        <strong>@_mob.SourceName</strong>
                        @if (_mob.SourceUrl != null)
                        { <a href="@_mob.SourceUrl" target="_blank" class="ms-2">@_mob.SourceUrl</a> }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><strong>@S["DataQuality"]</strong></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>@S["FinalScore"]</span>
                        <strong>@(_mob.FinalScore?.ToString("F2") ?? "—")</strong>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span>@S["Confidence"]</span>
                        <strong>@(_mob.ConfidenceScore?.ToString("F2") ?? "—")</strong>
                    </div>
                    <hr class="my-2" />
                    <div class="small text-muted">
                        @S["Created"]: @_mob.CreatedAt.ToString("dd.MM.yyyy")<br />
                        @S["Updated"]: @_mob.UpdatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><strong>@S["Actions"]</strong></div>
                <div class="card-body d-grid gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsync">@S["Save"]</button>
                    <div class="d-flex gap-1">
                        <button class="btn btn-success btn-sm flex-fill" @onclick='() => SetStatusAsync("approved")'
                                disabled="@(_mob.ContentStatus == "approved")">@S["Approve"]</button>
                        <button class="btn btn-danger btn-sm flex-fill" @onclick='() => SetStatusAsync("rejected")'
                                disabled="@(_mob.ContentStatus == "rejected")">@S["Reject"]</button>
                    </div>
                    <button class="btn @(_mob.IsEnabled ? "btn-outline-secondary" : "btn-outline-success") btn-sm"
                            @onclick="ToggleEnabledAsync">
                        @(_mob.IsEnabled ? S["ToggleOff"] : S["ToggleOn"])
                    </button>
                </div>
            </div>

            <div class="small text-muted">GUID: <code class="small">@_mob.Guid</code></div>
        </div>
    </div>
}

@if (_msg != null)
{
    <div class="toast-msg @(_isErr ? "toast-err" : "toast-ok") mt-3">@_msg</div>
}

@code {
    [Parameter] public Guid Guid { get; set; }

    // Operátor do auditu — bez toho by v ApprovalLog nebylo poznat, kdo změnu provedl
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private DetailMob? _mob;
    private string _editName = "";
    private string? _editLocaleName;
    private string? _editMobType;
    private string? _editRank;
    private string? _editDescription;
    private string? _msg;
    private bool _isErr;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mob = await Db.QueryFirstOrDefaultAsync<DetailMob>(
                @"SELECT ""Guid"", ""Vnum"", ""Name"", ""LocaleName"", ""MobType"", ""Rank"",
                         ""BattleType"", ""Level"", ""MaxHp"", ""Exp"",
                         ""GoldMin"", ""GoldMax"", ""GoldDropRate"",
                         ""AttackSpeed"", ""MoveSpeed"", ""Atk"", ""MagicAtk"", ""Def"", ""MagicDef"",
                         ""AggressiveSight"", ""AttackRange"", ""Description"",
                         ""SourceName"", ""SourceUrl"", ""ContentStatus"", ""IsEnabled"",
                         ""FinalScore"", ""ConfidenceScore"", ""CreatedAt"", ""UpdatedAt"",
                         ""DropItems""::text AS ""DropItemsJson""
                  FROM ""Mobs"" WHERE ""Guid"" = @g AND ""IsDeleted"" = FALSE",
                new { g = Guid });

            if (_mob != null)
            {
                _editName = _mob.Name;
                _editLocaleName = _mob.LocaleName;
                _editMobType = _mob.MobType;
                _editRank = _mob.Rank;
                _editDescription = _mob.Description;
            }
            if (_mob != null) await LoadDropsAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
        finally { _loading = false; }
    }

    private List<DropGroupJson> _drops = [];
    private Dictionary<int, NameRef> _itemNames = [];

    /// <summary>Dropy jsou jsonb u moba; jména itemů se dotáhnou jedním dotazem, ne po jednom.</summary>
    private async Task LoadDropsAsync()
    {
        _drops = JsonContent.ParseList<DropGroupJson>(_mob?.DropItemsJson);
        var vnums = _drops.SelectMany(g => g.Items).Where(i => i.Vnum.HasValue).Select(i => i.Vnum!.Value).Distinct().ToArray();
        if (vnums.Length == 0) return;
        var refs = await Db.QueryAsync<NameRef>(
            @"SELECT ""Guid"", ""Vnum"", coalesce(""LocaleName"", ""Name"") AS ""Label""
              FROM ""Items"" WHERE ""Vnum"" = ANY(@v) AND ""IsDeleted"" = FALSE",
            new { v = vnums });
        _itemNames = refs.GroupBy(r => r.Vnum).ToDictionary(g => g.Key, g => g.First());
    }

    private async Task SaveAsync()
    {
        if (_mob == null) return;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Mobs"" SET ""Name"" = @n, ""LocaleName"" = @l,
                         ""MobType"" = @t, ""Rank"" = @r, ""Description"" = @d, ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new { n = _editName, l = _editLocaleName, t = _editMobType, r = _editRank, d = _editDescription, g = _mob.Guid });
            _mob.Name = _editName;
            _mob.LocaleName = _editLocaleName;
            _mob.MobType = _editMobType;
            _mob.Rank = _editRank;
            _mob.Description = _editDescription;
            _msg = S["Saved"];
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private async Task SetStatusAsync(string status)
    {
        if (_mob == null) return;
        var op = await AuthState.OperatorNameAsync();
        var prev = _mob.ContentStatus;
        try
        {
            // Razítko schválení/zamítnutí patří k záznamu — seznamové stránky ho zapisují taky
            await Db.ExecuteAsync(
                @"UPDATE ""Mobs"" SET ""ContentStatus"" = @s,
                         ""ApprovedAt""  = CASE WHEN @s = 'approved' THEN NOW() ELSE ""ApprovedAt"" END,
                         ""ApprovedBy""  = CASE WHEN @s = 'approved' THEN @op   ELSE ""ApprovedBy"" END,
                         ""RejectedAt""  = CASE WHEN @s = 'rejected' THEN NOW() ELSE ""RejectedAt"" END,
                         ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new { s = status, op, g = _mob.Guid });
            await Db.ExecuteAsync(
                @"INSERT INTO ""ApprovalLog"" (""Guid"", ""EntityTable"", ""EntityGuid"", ""EntityVnum"", ""EntityName"", ""Action"", ""Operator"", ""PrevStatus"", ""NewStatus"", ""CreatedAt"")
                  VALUES (gen_random_uuid(), 'Mobs', @g, @vnum, @name, @s, @op, @prev, @s, NOW())",
                new { g = _mob.Guid, vnum = _mob.Vnum, name = _mob.Name, s = status, op, prev });
            _mob.ContentStatus = status;
            _msg = S["StatusChanged", status];
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private async Task ToggleEnabledAsync()
    {
        if (_mob == null) return;
        var newVal = !_mob.IsEnabled;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Mobs"" SET ""IsEnabled"" = @v, ""UpdatedAt"" = NOW() WHERE ""Guid"" = @g",
                new { v = newVal, g = _mob.Guid });
            _mob.IsEnabled = newVal;
            _msg = newVal ? S["MsgOn"] : S["MsgOff"];
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private static string StatusClass(string? s) => s switch
    {
        "approved" => "bg-success",
        "pending"  => "bg-warning text-dark",
        "rejected" => "bg-danger",
        _          => "bg-secondary"
    };
}
