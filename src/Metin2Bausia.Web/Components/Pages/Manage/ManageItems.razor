@page "/manage/items"
@* Sloučeno s bývalou Item databází — /items/browse byl tatáž tabulka s filtrem „schválené" *@
@page "/items/browse"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db

<PageTitle>@S["ManageItemsTitle"] — Metin2Bausia</PageTitle>

<h2>@S["ManageItemsTitle"]</h2>
<p class="text-muted mb-3">@((MarkupString)S["ManageItemsIntroHtml"].Value)</p>

<div class="toolbar mb-3 d-flex gap-2 align-items-center flex-wrap">
    <input class="form-control form-control-sm" style="max-width:220px"
           placeholder="@S["SearchNameVnum"]"
           @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />

    @* Na mobilu se filtry schovají pod rozbalovátko; nad 768 px je CSS rozbalí natrvalo *@
    <details class="filters">
        <summary class="btn btn-outline-secondary btn-sm">
            @S["Filters"]@(ActiveFilters > 0 ? $" ({ActiveFilters})" : "")
        </summary>
        <div class="filters__body d-flex gap-2 flex-wrap">
            <select class="form-select form-select-sm" style="max-width:160px" @bind="_filterEnabled" @bind:after="ResetPage">
                <option value="">@S["All"]</option>
                <option value="true">@S["Enabled"]</option>
                <option value="false">@S["Disabled"]</option>
            </select>
            <select class="form-select form-select-sm" style="max-width:160px" @bind="_filterStatus" @bind:after="ResetPage">
                <option value="">@S["AllStatuses"]</option>
                <option value="approved">@S["StatusApproved"]</option>
                <option value="pending">@S["StatusPending"]</option>
            </select>
        </div>
    </details>

    <span class="text-muted small ms-auto">@S["ShownOf", Filtered.Count(), _items.Count]</span>
</div>

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (!Filtered.Any())
{
    <div class="alert alert-info">@S["NoApprovedItems"]</div>
}
else
{
    <div class="table-responsive list-table">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-dark sticky-top">
                <tr>
                    <th style="width:56px">@S["On"]</th>
                    <SortableHeader Field="Vnum" Label="@S["ColVnum"]" @bind-SortBy="_sortBy" @bind-Ascending="_asc" OnSort="ResetPage" />
                    <SortableHeader Field="Name" Label="@S["ColName"]" @bind-SortBy="_sortBy" @bind-Ascending="_asc" OnSort="ResetPage" />
                    <th style="width:90px">@S["Type"]</th>
                    <th style="width:100px">@S["Status"]</th>
                    <th style="width:80px">@S["Source"]</th>
                    <th style="width:50px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Page)
                {
                    <tr class="@(item.IsEnabled ? "" : "opacity-60")">
                        <td class="text-center">
                            <div class="form-check form-switch d-flex justify-content-center">
                                <input class="form-check-input" type="checkbox"
                                       checked="@item.IsEnabled"
                                       @onchange="e => ToggleAsync(item, (bool)e.Value!)" />
                            </div>
                        </td>
                        <td><code class="small">@item.Vnum</code></td>
                        <td>
                            <strong>@item.Name</strong>
                            @if (item.LocaleName != null)
                            { <small class="text-muted"> (@item.LocaleName)</small> }
                        </td>
                        <td><span class="badge bg-secondary">@ContentLabels.ItemType(item.ItemType)</span></td>
                        <td>
                            <span class="badge @ContentLabels.StatusBadge(item.ContentStatus)">@item.ContentStatus</span>
                        </td>
                        <td>
                            @if (item.SourceUrl != null)
                            { <a href="@item.SourceUrl" target="_blank" class="small">@item.SourceName</a> }
                            else
                            { <span class="small text-muted">@item.SourceName</span> }
                        </td>
                        <td>
                            <a href="/manage/items/@item.Guid" class="btn btn-outline-secondary btn-sm py-0">→</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Mobil: stejná data jako v tabulce, ale pod sebou — sedm sloupců se do 375 px nevejde *@
    <div class="list-cards">
        @foreach (var item in Page)
        {
            <div class="list-card @(item.IsEnabled ? "" : "opacity-60")">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox"
                           checked="@item.IsEnabled"
                           @onchange="e => ToggleAsync(item, (bool)e.Value!)" />
                </div>
                <a class="list-card__main" href="/manage/items/@item.Guid">
                    <div class="list-card__title">@(item.LocaleName ?? item.Name)</div>
                    <div class="list-card__meta">
                        <code class="small">@item.Vnum</code>
                        <span class="badge bg-secondary">@ContentLabels.ItemType(item.ItemType)</span>
                        <span class="badge @ContentLabels.StatusBadge(item.ContentStatus)">@item.ContentStatus</span>
                    </div>
                </a>
                <span class="text-muted">›</span>
            </div>
        }
    </div>

    @if (TotalPages > 1)
    {
        <div class="mt-3">
            <Pager CurrentPage="_page" TotalPages="TotalPages" OnPageChanged="GoToPage" />
        </div>
    }
}

<ToastMessage Text="@ToastText" IsError="@ToastIsError" Stamp="@ToastStamp" />

@code {
    private const int PageSize = 50;

    private bool _loading = true;
    private List<ManageItem> _items = new();
    private string _search = "";
    private string _filterEnabled = "";
    private string _filterStatus = "approved";
    private string _sortBy = "Vnum";
    private bool _asc = true;
    private int _page = 1;

    private int ActiveFilters => (_filterEnabled == "" ? 0 : 1) + (_filterStatus == "" ? 0 : 1);

    private IEnumerable<ManageItem> Filtered => _items.Where(i =>
        (string.IsNullOrEmpty(_search) ||
            (i.Name?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true) ||
            (i.LocaleName?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true) ||
            (i.Vnum?.ToString() == _search)) &&
        (string.IsNullOrEmpty(_filterEnabled) || i.IsEnabled.ToString().ToLower() == _filterEnabled) &&
        (string.IsNullOrEmpty(_filterStatus) || i.ContentStatus == _filterStatus));

    private IEnumerable<ManageItem> Sorted =>
        _sortBy == "Name"
            ? (_asc ? Filtered.OrderBy(i => i.LocaleName ?? i.Name) : Filtered.OrderByDescending(i => i.LocaleName ?? i.Name))
            : (_asc ? Filtered.OrderBy(i => i.Vnum) : Filtered.OrderByDescending(i => i.Vnum));

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count() / (double)PageSize));

    // Stránkuje se až po filtrech: 2000 řádků v DOM dělalo na mobilu 140 000 px vysokou stránku
    private IEnumerable<ManageItem> Page => Sorted.Skip((_page - 1) * PageSize).Take(PageSize);

    private void ResetPage() => _page = 1;

    private void GoToPage(int page) => _page = page;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<ManageItem>(
                @"SELECT ""Guid"", ""Vnum"", ""Name"", ""LocaleName"", ""ItemType"",
                         ""ContentStatus"", ""IsEnabled"", ""SourceName"", ""SourceUrl""
                  FROM ""Items""
                  WHERE ""IsDeleted"" = FALSE
                  ORDER BY ""IsEnabled"" DESC, ""Vnum"" ASC NULLS LAST
                  LIMIT 2000")).ToList();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { _loading = false; }
    }

    private async Task ToggleAsync(ManageItem item, bool newValue)
    {
        var old = item.IsEnabled;
        item.IsEnabled = newValue;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Items"" SET ""IsEnabled"" = @v, ""IsEnabledLocked"" = TRUE, ""UpdatedAt"" = NOW() WHERE ""Guid"" = @g",
                new { v = newValue, g = item.Guid });
            ShowOk(newValue
                ? S["TurnedOn", item.Name ?? ""]
                : S["TurnedOff", item.Name ?? ""]);
        }
        catch (Exception ex)
        {
            item.IsEnabled = old;   // rollback UI
            ShowError(ex);
        }
    }
}
