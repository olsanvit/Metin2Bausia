@page "/manage/maps/{Guid:guid}"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db
@inject NavigationManager Nav

<PageTitle>@(_map?.Name ?? S["MapDetailTitle"]) — Metin2Bausia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/manage/maps" class="btn btn-outline-secondary btn-sm">@S["BackToMaps"]</a>
    @if (_map != null)
    {
        <span class="badge @StatusClass(_map.ContentStatus)">@_map.ContentStatus</span>
        <span class="badge @(_map.IsEnabled ? "bg-success" : "bg-secondary")">
            @(_map.IsEnabled ? S["On"] : S["Off"])
        </span>
    }
</div>

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (_map == null)
{
    <div class="alert alert-danger">@S["MapNotFound"]</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@S["BasicInfo"]</strong>
                    <code class="small">index @_map.MapIndex</code>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small">@S["InternalName"]</label>
                            <input class="form-control form-control-sm" @bind="_editName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@S["LocaleName"]</label>
                            <input class="form-control form-control-sm" @bind="_editLocaleName" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small">@S["MapType"]</label>
                            <select class="form-select form-select-sm" @bind="_editMapType">
                                <option value="">—</option>
                                <option value="field">@S["MapTypeField"]</option>
                                <option value="dungeon">Dungeon</option>
                                <option value="pvp">PvP</option>
                                <option value="guild">Guild</option>
                                <option value="empire">Empire</option>
                                <option value="boat">@S["MapTypeBoat"]</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@S["MinLevelLabel"]</label>
                            <input class="form-control form-control-sm" type="number" value="@_map.MinLevel" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@S["MaxLevelLabel"]</label>
                            <input class="form-control form-control-sm" type="number" value="@_map.MaxLevel" readonly />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">@S["Description"]</label>
                        <textarea class="form-control form-control-sm" rows="3" @bind="_editDescription"></textarea>
                    </div>
                    @if (_map.PreviewImageUrl != null)
                    {
                        <div class="mt-2">
                            <img src="@_map.PreviewImageUrl" class="img-fluid rounded" style="max-height:200px" alt="preview" />
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><strong>@S["MapDimensions"]</strong></div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-md-3">
                            <div class="small text-muted">@S["Width"]</div>
                            <div class="fw-bold">@(_map.Width?.ToString("N0") ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">@S["Height"]</div>
                            <div class="fw-bold">@(_map.Height?.ToString("N0") ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">@S["MinLevelLabel"]</div>
                            <div class="fw-bold">@(_map.MinLevel ?? 0)</div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">@S["MaxLevelLabel"]</div>
                            <div class="fw-bold">@(_map.MaxLevel ?? 0)</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Spawny ze souborů mapy (regen/boss/stone/npc) — typ určuje, jestli vnum je mob, nebo skupina *@
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@S["SpawnsTitle"]</strong>
                    @if (_spawns.Count > 0)
                    { <span class="small text-muted">@S["SpawnsSummary", _spawns.Count, _spawnFiles.Count]</span> }
                </div>
                <div class="card-body p-0">
                    @if (_spawns.Count == 0)
                    {
                        <p class="text-muted small m-3">@S["SpawnsNone"]</p>
                    }
                    else
                    {
                        <div class="p-2">
                            <select class="form-select form-select-sm" style="max-width:220px" @bind="_spawnFile">
                                <option value="">@S["AllFiles"]</option>
                                @foreach (var f in _spawnFiles) { <option value="@f">@f</option> }
                            </select>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0 align-middle">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>@S["SpawnFile"]</th><th>@S["SpawnType"]</th><th>@S["SpawnTarget"]</th>
                                        <th class="text-end">@S["SpawnPosition"]</th><th class="text-end">@S["SpawnRange"]</th>
                                        <th class="text-end">@S["SpawnTime"]</th><th class="text-end">@S["SpawnCount"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var sp in FilteredSpawns.Take(SpawnLimit))
                                {
                                    <tr>
                                        <td class="small text-muted">@sp.File</td>
                                        <td class="small">@SpawnTypeLabel(sp.Type)</td>
                                        <td class="small">@SpawnTargetLabel(sp)</td>
                                        <td class="text-end small">@sp.X, @sp.Y</td>
                                        <td class="text-end small">@sp.RangeX × @sp.RangeY</td>
                                        <td class="text-end small">@sp.Time</td>
                                        <td class="text-end small">@sp.Count</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        @if (FilteredSpawns.Count() > SpawnLimit)
                        {
                            <div class="text-center text-muted small p-2">@S["RowsLimited", SpawnLimit]</div>
                        }
                    }
                </div>
            </div>

            @if (_map.SourceName != null)
            {
                <div class="card mb-3">
                    <div class="card-header"><strong>@S["DataSource"]</strong></div>
                    <div class="card-body small">
                        <strong>@_map.SourceName</strong>
                        @if (_map.SourceUrl != null)
                        { <a href="@_map.SourceUrl" target="_blank" class="ms-2">@_map.SourceUrl</a> }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><strong>@S["DataQuality"]</strong></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>@S["FinalScore"]</span>
                        <strong>@(_map.FinalScore?.ToString("F2") ?? "—")</strong>
                    </div>
                    <hr class="my-2" />
                    <div class="small text-muted">
                        @S["Created"]: @_map.CreatedAt.ToString("dd.MM.yyyy")<br />
                        @S["Updated"]: @_map.UpdatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><strong>@S["Actions"]</strong></div>
                <div class="card-body d-grid gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsync">@S["Save"]</button>
                    <div class="d-flex gap-1">
                        <button class="btn btn-success btn-sm flex-fill" @onclick='() => SetStatusAsync("approved")'
                                disabled="@(_map.ContentStatus == "approved")">@S["Approve"]</button>
                        <button class="btn btn-danger btn-sm flex-fill" @onclick='() => SetStatusAsync("rejected")'
                                disabled="@(_map.ContentStatus == "rejected")">@S["Reject"]</button>
                    </div>
                    <button class="btn @(_map.IsEnabled ? "btn-outline-secondary" : "btn-outline-success") btn-sm"
                            @onclick="ToggleEnabledAsync">
                        @(_map.IsEnabled ? S["ToggleOff"] : S["ToggleOn"])
                    </button>
                </div>
            </div>

            <div class="small text-muted">GUID: <code class="small">@_map.Guid</code></div>
        </div>
    </div>
}

<ToastMessage Text="@ToastText" IsError="@ToastIsError" Stamp="@ToastStamp" />

@code {
    [Parameter] public Guid Guid { get; set; }

    // Operátor do auditu — bez toho by v ApprovalLog nebylo poznat, kdo změnu provedl
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private DetailMap? _map;
    private string _editName = "";
    private string? _editLocaleName;
    private string? _editMapType;
    private string? _editDescription;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _map = await Db.QueryFirstOrDefaultAsync<DetailMap>(
                @"SELECT ""Guid"", ""MapIndex"", ""Name"", ""LocaleName"", ""MapType"",
                         ""Width"", ""Height"", ""MinLevel"", ""MaxLevel"",
                         ""Description"", ""PreviewImageUrl"",
                         ""SourceName"", ""SourceUrl"", ""ContentStatus"", ""IsEnabled"",
                         ""FinalScore"", ""CreatedAt"", ""UpdatedAt"",
                         ""SpawnMobs""::text AS ""SpawnMobsJson""
                  FROM ""Maps"" WHERE ""Guid"" = @g AND ""IsDeleted"" = FALSE",
                new { g = Guid });

            if (_map != null)
            {
                _editName = _map.Name;
                _editLocaleName = _map.LocaleName;
                _editMapType = _map.MapType;
                _editDescription = _map.Description;
            }
            if (_map != null) await LoadSpawnsAsync();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { _loading = false; }
    }

    // Velké mapy mají tisíce spawnů (regen.txt) — víc řádků by jen zpomalilo circuit
    private const int SpawnLimit = 500;
    private List<SpawnJson> _spawns = [];
    private List<string> _spawnFiles = [];
    private string _spawnFile = "";
    private Dictionary<int, string> _mobNames = [];
    private Dictionary<(string Type, int Vnum), string> _groupNames = [];

    private IEnumerable<SpawnJson> FilteredSpawns =>
        string.IsNullOrEmpty(_spawnFile) ? _spawns : _spawns.Where(s => s.File == _spawnFile);

    // Typ spawnu podle game/src/regen.cpp: m/ma a s = mob, g/ga = skupina (group.txt), r = skupina skupin
    private static bool IsMobSpawn(string? t) => t is "m" or "ma" or "s";

    private string SpawnTypeLabel(string? t) => t switch
    {
        "m" => S["SpawnTypeMob"],
        "ma" => $"{S["SpawnTypeMob"]} ({S["SpawnAggressive"]})",
        "g" => S["SpawnTypeGroup"],
        "ga" => $"{S["SpawnTypeGroup"]} ({S["SpawnAggressive"]})",
        "r" => S["SpawnTypeGroupGroup"],
        "s" => S["SpawnTypeAnywhere"],
        "e" => S["SpawnTypeException"],
        _ => t ?? "?"
    };

    private string SpawnTargetLabel(SpawnJson sp)
    {
        if (sp.Type == "e") return "—";
        string? label = IsMobSpawn(sp.Type)
            ? _mobNames.GetValueOrDefault(sp.Vnum)
            : _groupNames.GetValueOrDefault((sp.Type == "r" ? "mob_group_group" : "mob_group", sp.Vnum));
        return label is null ? sp.Vnum.ToString() : $"{label} ({sp.Vnum})";
    }

    /// <summary>Spawny jsou jsonb u mapy; jména mobů a skupin se dotáhnou dvěma dotazy pro celou mapu.</summary>
    private async Task LoadSpawnsAsync()
    {
        _spawns = JsonContent.ParseList<SpawnJson>(_map?.SpawnMobsJson);
        _spawnFiles = _spawns.Select(s => s.File ?? "").Distinct().OrderBy(f => f).ToList();
        var mobVnums = _spawns.Where(s => IsMobSpawn(s.Type)).Select(s => s.Vnum).Distinct().ToArray();
        var groupVnums = _spawns.Where(s => s.Type is "g" or "ga" or "r").Select(s => s.Vnum).Distinct().ToArray();
        if (mobVnums.Length > 0)
        {
            var mobs = await Db.QueryAsync<NameRef>(
                @"SELECT ""Vnum"", coalesce(""LocaleName"", ""Name"") AS ""Label""
                  FROM ""Mobs"" WHERE ""Vnum"" = ANY(@v) AND ""IsDeleted"" = FALSE",
                new { v = mobVnums });
            _mobNames = mobs.GroupBy(m => m.Vnum).ToDictionary(g => g.Key, g => g.First().Label ?? "");
        }
        if (groupVnums.Length > 0)
        {
            var groups = await Db.QueryAsync<NameRef>(
                @"SELECT ""GroupVnum"" AS ""Vnum"", ""GroupType"", ""Name"" AS ""Label""
                  FROM ""ContentGroups"" WHERE ""GroupVnum"" = ANY(@v) AND ""IsDeleted"" = FALSE",
                new { v = groupVnums });
            _groupNames = groups.GroupBy(g => (g.GroupType ?? "", g.Vnum)).ToDictionary(g => g.Key, g => g.First().Label ?? "");
        }
    }

    private async Task SaveAsync()
    {
        if (_map == null) return;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Maps"" SET ""Name"" = @n, ""LocaleName"" = @l,
                         ""MapType"" = @t, ""Description"" = @d, ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new { n = _editName, l = _editLocaleName, t = _editMapType, d = _editDescription, g = _map.Guid });
            _map.Name = _editName;
            _map.LocaleName = _editLocaleName;
            _map.MapType = _editMapType;
            _map.Description = _editDescription;
            ShowOk(S["Saved"]);
        }
        catch (Exception ex) { ShowError(ex); }
    }

    private async Task SetStatusAsync(string status)
    {
        if (_map == null) return;
        var op = await AuthState.OperatorNameAsync();
        var prev = _map.ContentStatus;
        try
        {
            // Razítko schválení/zamítnutí patří k záznamu — seznamové stránky ho zapisují taky
            await Db.ExecuteAsync(
                @"UPDATE ""Maps"" SET ""ContentStatus"" = @s,
                         ""ApprovedAt""  = CASE WHEN @s = 'approved' THEN NOW() ELSE ""ApprovedAt"" END,
                         ""ApprovedBy""  = CASE WHEN @s = 'approved' THEN @op   ELSE ""ApprovedBy"" END,
                         ""RejectedAt""  = CASE WHEN @s = 'rejected' THEN NOW() ELSE ""RejectedAt"" END,
                         ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new { s = status, op, g = _map.Guid });
            await Db.ExecuteAsync(
                @"INSERT INTO ""ApprovalLog"" (""Guid"", ""EntityTable"", ""EntityGuid"", ""EntityVnum"", ""EntityName"", ""Action"", ""Operator"", ""PrevStatus"", ""NewStatus"", ""CreatedAt"")
                  VALUES (gen_random_uuid(), 'Maps', @g, @vnum, @name, @s, @op, @prev, @s, NOW())",
                new { g = _map.Guid, vnum = _map.MapIndex, name = _map.Name, s = status, op, prev });
            _map.ContentStatus = status;
            ShowOk(S["StatusChanged", status]);
        }
        catch (Exception ex) { ShowError(ex); }
    }

    private async Task ToggleEnabledAsync()
    {
        if (_map == null) return;
        var newVal = !_map.IsEnabled;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Maps"" SET ""IsEnabled"" = @v, ""IsEnabledLocked"" = TRUE, ""UpdatedAt"" = NOW() WHERE ""Guid"" = @g",
                new { v = newVal, g = _map.Guid });
            _map.IsEnabled = newVal;
            ShowOk(newVal ? S["MsgOn"] : S["MsgOff"]);
        }
        catch (Exception ex) { ShowError(ex); }
    }

    private static string StatusClass(string? s) => s switch
    {
        "approved" => "bg-success",
        "pending"  => "bg-warning text-dark",
        "rejected" => "bg-danger",
        _          => "bg-secondary"
    };
}
