@page "/manage/maps/{Guid:guid}"
@attribute [Authorize]
@inject IDbService Db
@inject NavigationManager Nav

<PageTitle>@(_map?.Name ?? "Mapa detail") — Metin2Bausia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/manage/maps" class="btn btn-outline-secondary btn-sm">← Zpět na mapy</a>
    @if (_map != null)
    {
        <span class="badge @StatusClass(_map.ContentStatus)">@_map.ContentStatus</span>
        <span class="badge @(_map.IsEnabled ? "bg-success" : "bg-secondary")">
            @(_map.IsEnabled ? "Zapnuto" : "Vypnuto")
        </span>
    }
</div>

@if (_loading)
{
    <p>Načítám...</p>
}
else if (_map == null)
{
    <div class="alert alert-danger">Mapa nenalezena.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Základní informace</strong>
                    <code class="small">index @_map.MapIndex</code>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small">Název (interní)</label>
                            <input class="form-control form-control-sm" @bind="_editName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Lokalizovaný název</label>
                            <input class="form-control form-control-sm" @bind="_editLocaleName" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small">Typ mapy</label>
                            <select class="form-select form-select-sm" @bind="_editMapType">
                                <option value="">—</option>
                                <option value="field">Venkovní (field)</option>
                                <option value="dungeon">Dungeon</option>
                                <option value="pvp">PvP</option>
                                <option value="guild">Guild</option>
                                <option value="empire">Empire</option>
                                <option value="boat">Loď (boat)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Min. level</label>
                            <input class="form-control form-control-sm" type="number" value="@_map.MinLevel" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Max. level</label>
                            <input class="form-control form-control-sm" type="number" value="@_map.MaxLevel" readonly />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Popis</label>
                        <textarea class="form-control form-control-sm" rows="3" @bind="_editDescription"></textarea>
                    </div>
                    @if (_map.PreviewImageUrl != null)
                    {
                        <div class="mt-2">
                            <img src="@_map.PreviewImageUrl" class="img-fluid rounded" style="max-height:200px" alt="preview" />
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><strong>Rozměry mapy</strong></div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-md-3">
                            <div class="small text-muted">Šířka</div>
                            <div class="fw-bold">@(_map.Width?.ToString("N0") ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">Výška</div>
                            <div class="fw-bold">@(_map.Height?.ToString("N0") ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">Min. level</div>
                            <div class="fw-bold">@(_map.MinLevel ?? 0)</div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">Max. level</div>
                            <div class="fw-bold">@(_map.MaxLevel ?? 0)</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (_map.SourceName != null)
            {
                <div class="card mb-3">
                    <div class="card-header"><strong>Zdroj dat</strong></div>
                    <div class="card-body small">
                        <strong>@_map.SourceName</strong>
                        @if (_map.SourceUrl != null)
                        { <a href="@_map.SourceUrl" target="_blank" class="ms-2">@_map.SourceUrl</a> }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><strong>Kvalita dat</strong></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Final Score</span>
                        <strong>@(_map.FinalScore?.ToString("F2") ?? "—")</strong>
                    </div>
                    <hr class="my-2" />
                    <div class="small text-muted">
                        Vytvořeno: @_map.CreatedAt.ToString("dd.MM.yyyy")<br />
                        Aktualizováno: @_map.UpdatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><strong>Akce</strong></div>
                <div class="card-body d-grid gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Uložit změny</button>
                    <div class="d-flex gap-1">
                        <button class="btn btn-success btn-sm flex-fill" @onclick='() => SetStatusAsync("approved")'
                                disabled="@(_map.ContentStatus == "approved")">✓ Schválit</button>
                        <button class="btn btn-danger btn-sm flex-fill" @onclick='() => SetStatusAsync("rejected")'
                                disabled="@(_map.ContentStatus == "rejected")">✗ Zamítnout</button>
                    </div>
                    <button class="btn @(_map.IsEnabled ? "btn-outline-secondary" : "btn-outline-success") btn-sm"
                            @onclick="ToggleEnabledAsync">
                        @(_map.IsEnabled ? "⊘ Vypnout" : "✓ Zapnout")
                    </button>
                </div>
            </div>

            <div class="small text-muted">GUID: <code class="small">@_map.Guid</code></div>
        </div>
    </div>
}

@if (_msg != null)
{
    <div class="toast-msg @(_isErr ? "toast-err" : "toast-ok") mt-3">@_msg</div>
}

@code {
    [Parameter] public Guid Guid { get; set; }

    private bool _loading = true;
    private DetailMap? _map;
    private string _editName = "";
    private string? _editLocaleName;
    private string? _editMapType;
    private string? _editDescription;
    private string? _msg;
    private bool _isErr;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _map = await Db.QueryFirstOrDefaultAsync<DetailMap>(
                @"SELECT ""Guid"", ""MapIndex"", ""Name"", ""LocaleName"", ""MapType"",
                         ""Width"", ""Height"", ""MinLevel"", ""MaxLevel"",
                         ""Description"", ""PreviewImageUrl"",
                         ""SourceName"", ""SourceUrl"", ""ContentStatus"", ""IsEnabled"",
                         ""FinalScore"", ""CreatedAt"", ""UpdatedAt""
                  FROM ""Maps"" WHERE ""Guid"" = @g AND ""IsDeleted"" = FALSE",
                new { g = Guid });

            if (_map != null)
            {
                _editName = _map.Name;
                _editLocaleName = _map.LocaleName;
                _editMapType = _map.MapType;
                _editDescription = _map.Description;
            }
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_map == null) return;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Maps"" SET ""Name"" = @n, ""LocaleName"" = @l,
                         ""MapType"" = @t, ""Description"" = @d, ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new { n = _editName, l = _editLocaleName, t = _editMapType, d = _editDescription, g = _map.Guid });
            _map.Name = _editName;
            _map.LocaleName = _editLocaleName;
            _map.MapType = _editMapType;
            _map.Description = _editDescription;
            _msg = "✓ Uloženo";
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private async Task SetStatusAsync(string status)
    {
        if (_map == null) return;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Maps"" SET ""ContentStatus"" = @s, ""UpdatedAt"" = NOW() WHERE ""Guid"" = @g",
                new { s = status, g = _map.Guid });
            _map.ContentStatus = status;
            _msg = $"Status: {status}";
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private async Task ToggleEnabledAsync()
    {
        if (_map == null) return;
        var newVal = !_map.IsEnabled;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Maps"" SET ""IsEnabled"" = @v, ""UpdatedAt"" = NOW() WHERE ""Guid"" = @g",
                new { v = newVal, g = _map.Guid });
            _map.IsEnabled = newVal;
            _msg = newVal ? "✓ Zapnuto" : "○ Vypnuto";
            _isErr = false;
        }
        catch (Exception ex) { _msg = ex.Message; _isErr = true; }
    }

    private static string StatusClass(string? s) => s switch
    {
        "approved" => "bg-success",
        "pending"  => "bg-warning text-dark",
        "rejected" => "bg-danger",
        _          => "bg-secondary"
    };
}
