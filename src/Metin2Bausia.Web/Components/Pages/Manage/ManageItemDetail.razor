@page "/manage/items/{Guid:guid}"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db
@inject NavigationManager Nav

<PageTitle>@(_item?.Name ?? S["ItemDetailTitle"]) — Metin2Bausia</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/manage/items" class="btn btn-outline-secondary btn-sm">@S["BackToItems"]</a>
    @if (_item != null)
    {
        <span class="badge @StatusClass(_item.ContentStatus)">@_item.ContentStatus</span>
        <span class="badge @(_item.IsEnabled ? "bg-success" : "bg-secondary")">
            @(_item.IsEnabled ? S["On"] : S["Off"])
        </span>
    }
</div>

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else if (_item == null)
{
    <div class="alert alert-danger">@S["ItemNotFound"]</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Základní info -->
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@S["BasicInfo"]</strong>
                    <code class="small">vnum @_item.Vnum</code>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small">@S["InternalName"]</label>
                            <input class="form-control form-control-sm" @bind="_editName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@S["LocaleName"]</label>
                            <input class="form-control form-control-sm" @bind="_editLocaleName" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small">@S["Type"]</label>
                            <select class="form-select form-select-sm" @bind="_editItemType">
                                <option value="">—</option>
                                <option value="weapon">@S["ItemTypeWeapon"]</option>
                                <option value="armor">@S["ItemTypeArmor"]</option>
                                <option value="ring">@S["ItemTypeRing"]</option>
                                <option value="belt">@S["ItemTypeBelt"]</option>
                                <option value="boots">@S["ItemTypeBoots"]</option>
                                <option value="necklace">@S["ItemTypeNecklace"]</option>
                                <option value="bracelet">@S["ItemTypeBracelet"]</option>
                                <option value="shield">@S["ItemTypeShield"]</option>
                                <option value="bow">@S["ItemTypeBow"]</option>
                                <option value="arrow">@S["ItemTypeArrow"]</option>
                                <option value="potion">@S["ItemTypePotion"]</option>
                                <option value="quest">Quest</option>
                                <option value="unique">@S["ItemTypeUnique"]</option>
                                <option value="special">@S["ItemTypeSpecial"]</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@S["Weight"]</label>
                            <input class="form-control form-control-sm" type="number" min="0" @bind="_item.Weight" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@S["Size"]</label>
                            <input class="form-control form-control-sm" type="number" min="1" @bind="_item.Size" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">@S["Description"]</label>
                        <textarea class="form-control form-control-sm" rows="3" @bind="_editDescription"></textarea>
                    </div>
                </div>
            </div>

            <!-- Ceny a atributy -->
            <div class="card mb-3">
                <div class="card-header"><strong>@S["PricesAttributes"]</strong></div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small">@S["SellPrice"]</label>
                            <input class="form-control form-control-sm" type="number" min="0" @bind="_item.Gold" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@S["BuyPrice"]</label>
                            <input class="form-control form-control-sm" type="number" min="0" @bind="_item.Buy" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_item.LimitType0) || !string.IsNullOrEmpty(_item.LimitType1))
                    {
                        <p class="small fw-bold text-muted mb-1">@S["Limits"]</p>
                        <div class="row g-2 mb-2">
                            @if (!string.IsNullOrEmpty(_item.LimitType0))
                            {
                                <div class="col-md-6"><label class="form-label small"><code>@_item.LimitType0</code></label>
                                <input class="form-control form-control-sm" type="number" @bind="_item.LimitValue0" /></div>
                            }
                            @if (!string.IsNullOrEmpty(_item.LimitType1))
                            {
                                <div class="col-md-6"><label class="form-label small"><code>@_item.LimitType1</code></label>
                                <input class="form-control form-control-sm" type="number" @bind="_item.LimitValue1" /></div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_item.ApplyType0) || !string.IsNullOrEmpty(_item.ApplyType1) || !string.IsNullOrEmpty(_item.ApplyType2))
                    {
                        <p class="small fw-bold text-muted mb-1">@S["Bonuses"]</p>
                        <div class="row g-2 mb-2">
                            @if (!string.IsNullOrEmpty(_item.ApplyType0))
                            {
                                <div class="col-md-4"><label class="form-label small"><code>@_item.ApplyType0</code></label>
                                <input class="form-control form-control-sm" type="number" @bind="_item.ApplyValue0" /></div>
                            }
                            @if (!string.IsNullOrEmpty(_item.ApplyType1))
                            {
                                <div class="col-md-4"><label class="form-label small"><code>@_item.ApplyType1</code></label>
                                <input class="form-control form-control-sm" type="number" @bind="_item.ApplyValue1" /></div>
                            }
                            @if (!string.IsNullOrEmpty(_item.ApplyType2))
                            {
                                <div class="col-md-4"><label class="form-label small"><code>@_item.ApplyType2</code></label>
                                <input class="form-control form-control-sm" type="number" @bind="_item.ApplyValue2" /></div>
                            }
                        </div>
                    }

                    <p class="small fw-bold text-muted mb-1">@S["Values"]</p>
                    <div class="row g-2">
                        <div class="col-4 col-md-2">
                            <label class="form-label small">v0</label>
                            <input class="form-control form-control-sm" type="number" @bind="_item.Value0" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small">v1</label>
                            <input class="form-control form-control-sm" type="number" @bind="_item.Value1" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small">v2</label>
                            <input class="form-control form-control-sm" type="number" @bind="_item.Value2" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small">v3</label>
                            <input class="form-control form-control-sm" type="number" @bind="_item.Value3" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small">v4</label>
                            <input class="form-control form-control-sm" type="number" @bind="_item.Value4" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small">v5</label>
                            <input class="form-control form-control-sm" type="number" @bind="_item.Value5" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Zdroj -->
            @if (_item.SourceName != null)
            {
                @* Na mobilu sbalené — kouká se sem zřídka a zbytečně prodlužovalo stránku *@
                <details class="card mb-3 collapsible">
                    <summary class="card-header"><strong>@S["DataSource"]</strong></summary>
                    <div class="card-body small">
                        <strong>@_item.SourceName</strong>
                        @if (_item.SourceUrl != null)
                        { <a href="@_item.SourceUrl" target="_blank" class="ms-2">@_item.SourceUrl</a> }
                    </div>
                </details>
            }
        </div>

        <div class="col-lg-4">
            <!-- Skóre -->
            <details class="card mb-3 collapsible">
                <summary class="card-header"><strong>@S["DataQuality"]</strong></summary>
                <div class="card-body">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>@S["FinalScore"]</span>
                        <strong>@(_item.FinalScore?.ToString("F2") ?? "—")</strong>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span>@S["Confidence"]</span>
                        <strong>@(_item.ConfidenceScore?.ToString("F2") ?? "—")</strong>
                    </div>
                    <hr class="my-2" />
                    <div class="small text-muted">
                        @S["Created"]: @_item.CreatedAt.ToString("dd.MM.yyyy")<br />
                        @S["Updated"]: @_item.UpdatedAt.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </details>

            @* Akce musí být po ruce i uprostřed dlouhého formuláře — dřív byly na mobilu až úplně dole *@
            <div class="card mb-3 detail-actions">
                <div class="card-header d-none d-lg-block"><strong>@S["Actions"]</strong></div>
                <div class="card-body d-grid gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsync">
                        @S["Save"]@(IsDirty ? " •" : "")
                    </button>
                    <div class="small text-muted d-none d-lg-block">@S["Origin"]: <code>@(_item.DataOrigin ?? "—")</code><br />@S["ManualEditNote"]</div>

                    <div class="d-flex gap-1">
                        <button class="btn btn-success btn-sm flex-fill" @onclick='() => SetStatusAsync("approved")'
                                disabled="@(_item.ContentStatus == "approved")">
                            @S["Approve"]
                        </button>
                        <button class="btn btn-danger btn-sm flex-fill" @onclick='() => SetStatusAsync("rejected")'
                                disabled="@(_item.ContentStatus == "rejected")">
                            @S["Reject"]
                        </button>
                    </div>

                    <button class="btn @(_item.IsEnabled ? "btn-outline-secondary" : "btn-outline-success") btn-sm"
                            @onclick="ToggleEnabledAsync">
                        @(_item.IsEnabled ? S["ToggleOff"] : S["ToggleOn"])
                    </button>
                </div>
            </div>

            <div class="small text-muted">GUID: <code class="small">@_item.Guid</code></div>
        </div>
    </div>
}

<ToastMessage Text="@ToastText" IsError="@ToastIsError" Stamp="@ToastStamp" />

@code {
    [Parameter] public Guid Guid { get; set; }

    // Operátor do auditu — bez toho by v ApprovalLog nebylo poznat, kdo změnu provedl
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private DetailItem? _item;
    private string _editName = "";
    private string? _editLocaleName;
    private string? _editItemType;
    private string? _editDescription;
    private string _snapshot = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _item = await Db.QueryFirstOrDefaultAsync<DetailItem>(
                @"SELECT ""Guid"", ""Vnum"", ""Name"", ""LocaleName"", ""ItemType"", ""SubType"",
                         ""Weight"", ""Size"", ""Gold"", ""Buy"",
                         ""LimitType0"", ""LimitValue0"", ""LimitType1"", ""LimitValue1"",
                         ""ApplyType0"", ""ApplyValue0"", ""ApplyType1"", ""ApplyValue1"", ""ApplyType2"", ""ApplyValue2"",
                         ""Value0"", ""Value1"", ""Value2"", ""Value3"", ""Value4"", ""Value5"",
                         ""Description"", ""SourceName"", ""SourceUrl"", ""DataOrigin"",
                         ""ContentStatus"", ""IsEnabled"", ""FinalScore"", ""ConfidenceScore"",
                         ""CreatedAt"", ""UpdatedAt""
                  FROM ""Items"" WHERE ""Guid"" = @g AND ""IsDeleted"" = FALSE",
                new { g = Guid });

            if (_item != null)
            {
                _editName = _item.Name;
                _editLocaleName = _item.LocaleName;
                _editItemType = _item.ItemType;
                _editDescription = _item.Description;
                _snapshot = Snapshot();
            }
        }
        catch (Exception ex) { ShowError(ex); }
        finally { _loading = false; }
    }

    // Porovnání proti stavu po načtení — jinak není poznat, že odchod ze stránky zahodí úpravy
    private string Snapshot() => string.Join('|',
        _editName, _editLocaleName, _editItemType, _editDescription,
        _item?.Gold, _item?.Buy, _item?.Weight, _item?.Size,
        _item?.LimitValue0, _item?.LimitValue1,
        _item?.ApplyValue0, _item?.ApplyValue1, _item?.ApplyValue2,
        _item?.Value0, _item?.Value1, _item?.Value2, _item?.Value3, _item?.Value4, _item?.Value5);

    private bool IsDirty => _item != null && Snapshot() != _snapshot;

    private async Task SaveAsync()
    {
        if (_item == null) return;
        try
        {
            await Db.ExecuteAsync(
                // Ruční úprava přepne původ na 'manual' — opakovaný import přepisuje jen řádky 'imported'
                @"UPDATE ""Items"" SET ""Name"" = @n, ""LocaleName"" = @l,
                         ""ItemType"" = @t, ""Description"" = @d,
                         ""Gold"" = @Gold, ""Buy"" = @Buy, ""Weight"" = @Weight, ""Size"" = @Size,
                         ""LimitValue0"" = @LimitValue0, ""LimitValue1"" = @LimitValue1,
                         ""ApplyValue0"" = @ApplyValue0, ""ApplyValue1"" = @ApplyValue1, ""ApplyValue2"" = @ApplyValue2,
                         ""Value0"" = @Value0, ""Value1"" = @Value1, ""Value2"" = @Value2,
                         ""Value3"" = @Value3, ""Value4"" = @Value4, ""Value5"" = @Value5,
                         ""DataOrigin"" = CASE WHEN ""DataOrigin"" = 'imported' THEN 'manual' ELSE ""DataOrigin"" END,
                         ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new
                {
                    n = _editName, l = _editLocaleName, t = _editItemType, d = _editDescription, g = _item.Guid,
                    _item.Gold, _item.Buy, _item.Weight, _item.Size,
                    _item.LimitValue0, _item.LimitValue1,
                    _item.ApplyValue0, _item.ApplyValue1, _item.ApplyValue2,
                    _item.Value0, _item.Value1, _item.Value2, _item.Value3, _item.Value4, _item.Value5,
                });
            if (_item.DataOrigin == "imported") _item.DataOrigin = "manual";
            _item.Name = _editName;
            _item.LocaleName = _editLocaleName;
            _item.ItemType = _editItemType;
            _item.Description = _editDescription;
            _snapshot = Snapshot();
            ShowOk(S["Saved"]);
        }
        catch (Exception ex) { ShowError(ex); }
    }

    private async Task SetStatusAsync(string status)
    {
        if (_item == null) return;
        var op = await AuthState.OperatorNameAsync();
        var prev = _item.ContentStatus;
        try
        {
            // Razítko schválení/zamítnutí patří k záznamu — seznamové stránky ho zapisují taky
            await Db.ExecuteAsync(
                @"UPDATE ""Items"" SET ""ContentStatus"" = @s,
                         ""ApprovedAt""  = CASE WHEN @s = 'approved' THEN NOW() ELSE ""ApprovedAt"" END,
                         ""ApprovedBy""  = CASE WHEN @s = 'approved' THEN @op   ELSE ""ApprovedBy"" END,
                         ""RejectedAt""  = CASE WHEN @s = 'rejected' THEN NOW() ELSE ""RejectedAt"" END,
                         ""UpdatedAt"" = NOW()
                  WHERE ""Guid"" = @g",
                new { s = status, op, g = _item.Guid });
            await Db.ExecuteAsync(
                @"INSERT INTO ""ApprovalLog"" (""Guid"", ""EntityTable"", ""EntityGuid"", ""EntityVnum"", ""EntityName"", ""Action"", ""Operator"", ""PrevStatus"", ""NewStatus"", ""CreatedAt"")
                  VALUES (gen_random_uuid(), 'Items', @g, @vnum, @name, @s, @op, @prev, @s, NOW())",
                new { g = _item.Guid, vnum = _item.Vnum, name = _item.Name, s = status, op, prev });
            _item.ContentStatus = status;
            ShowOk(S["StatusChanged", status]);
        }
        catch (Exception ex) { ShowError(ex); }
    }

    private async Task ToggleEnabledAsync()
    {
        if (_item == null) return;
        var newVal = !_item.IsEnabled;
        try
        {
            await Db.ExecuteAsync(
                @"UPDATE ""Items"" SET ""IsEnabled"" = @v, ""IsEnabledLocked"" = TRUE, ""UpdatedAt"" = NOW() WHERE ""Guid"" = @g",
                new { v = newVal, g = _item.Guid });
            _item.IsEnabled = newVal;
            ShowOk(newVal ? S["MsgOn"] : S["MsgOff"]);
        }
        catch (Exception ex) { ShowError(ex); }
    }

    private static string StatusClass(string? s) => s switch
    {
        "approved" => "bg-success",
        "pending"  => "bg-warning text-dark",
        "rejected" => "bg-danger",
        _          => "bg-secondary"
    };
}
