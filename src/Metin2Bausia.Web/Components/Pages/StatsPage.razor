@page "/stats"
@attribute [Authorize]
@inject IDbService Db

<PageTitle>Statistiky — Metin2Bausia</PageTitle>

<h2>Statistiky databáze</h2>

@if (_loading)
{
    <p>Načítám...</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-bg-primary h-100">
                <div class="card-body">
                    <div class="card-title small text-white-50">Itemy celkem</div>
                    <div class="fs-2 fw-bold">@_itemTotal</div>
                    <div class="small text-white-50">@_itemApproved schválených · @_itemEnabled zapnutých</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-bg-danger h-100">
                <div class="card-body">
                    <div class="card-title small text-white-50">Mobové celkem</div>
                    <div class="fs-2 fw-bold">@_mobTotal</div>
                    <div class="small text-white-50">@_mobApproved schválených · @_mobEnabled zapnutých</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-bg-success h-100">
                <div class="card-body">
                    <div class="card-title small text-white-50">Mapy</div>
                    <div class="fs-2 fw-bold">@_mapTotal</div>
                    <div class="small text-white-50">@_mapEnabled zapnutých</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-bg-warning h-100">
                <div class="card-body">
                    <div class="card-title small text-white-50">Systémy</div>
                    <div class="fs-2 fw-bold">@_sysTotal</div>
                    <div class="small text-white-50">@_sysEnabled zapnutých</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        @* Itemy podle typu *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">⚔️ Itemy podle typu</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-secondary">
                            <tr><th>Typ</th><th class="text-end">Počet</th><th>Podíl</th></tr>
                        </thead>
                        <tbody>
                            @{ int itemMax = _itemsByType.FirstOrDefault()?.Count ?? 1; }
                            @foreach (var row in _itemsByType.Take(15))
                            {
                                <tr>
                                    <td class="small">@ItemTypeName(row.ItemType)</td>
                                    <td class="text-end small">@row.Count</td>
                                    <td style="min-width:80px">
                                        <div class="progress" style="height:4px">
                                            <div class="progress-bar bg-primary" style="width:@(row.Count * 100 / itemMax)%"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Mobové podle ranku *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">👹 Mobové podle ranku</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-secondary">
                            <tr><th>Rank</th><th class="text-end">Počet</th><th>Podíl</th></tr>
                        </thead>
                        <tbody>
                            @{ int mobMax = _mobsByRank.FirstOrDefault()?.Count ?? 1; }
                            @foreach (var row in _mobsByRank)
                            {
                                <tr>
                                    <td class="small">@MobRankName(row.Rank)</td>
                                    <td class="text-end small">@row.Count</td>
                                    <td style="min-width:80px">
                                        <div class="progress" style="height:4px">
                                            <div class="progress-bar bg-danger" style="width:@(row.Count * 100 / mobMax)%"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Confidence distribuce itemů *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">📊 Confidence — Itemy</div>
                <div class="card-body">
                    @{ int totalConf = _itemsByConf.Sum(c => c.Count); }
                    @foreach (var band in _itemsByConf)
                    {
                        int pct = totalConf > 0 ? band.Count * 100 / totalConf : 0;
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="small text-muted" style="min-width:80px">@band.Label</span>
                            <div class="progress flex-grow-1" style="height:14px">
                                <div class="progress-bar @band.Css" style="width:@pct%">
                                    @if (pct > 10) { <span class="small">@band.Count</span> }
                                </div>
                            </div>
                            <span class="small text-muted" style="min-width:30px">@pct%</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Mobové úrovně - rozdělení *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">📊 Mobové — level distribuce</div>
                <div class="card-body">
                    @{ int totalMobConf = _mobsByLevel.Sum(c => c.Count); }
                    @foreach (var band in _mobsByLevel)
                    {
                        int pct = totalMobConf > 0 ? band.Count * 100 / totalMobConf : 0;
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="small text-muted" style="min-width:80px">@band.Label</span>
                            <div class="progress flex-grow-1" style="height:14px">
                                <div class="progress-bar @band.Css" style="width:@pct%">
                                    @if (pct > 10) { <span class="small">@band.Count</span> }
                                </div>
                            </div>
                            <span class="small text-muted" style="min-width:30px">@pct%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private int _itemTotal, _itemApproved, _itemEnabled;
    private int _mobTotal, _mobApproved, _mobEnabled;
    private int _mapTotal, _mapEnabled;
    private int _sysTotal, _sysEnabled;

    private record TypeCount(int? ItemType, int Count);
    private record RankCount(int? Rank, int Count);
    private record Band(string Label, int Count, string Css);

    private List<TypeCount> _itemsByType = [];
    private List<RankCount> _mobsByRank = [];
    private List<Band> _itemsByConf = [];
    private List<Band> _mobsByLevel = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _itemTotal    = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"IsDeleted\"=FALSE");
            _itemApproved = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ContentStatus\"='approved' AND \"IsDeleted\"=FALSE");
            _itemEnabled  = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"IsEnabled\"=TRUE AND \"IsDeleted\"=FALSE");
            _mobTotal     = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"IsDeleted\"=FALSE");
            _mobApproved  = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"ContentStatus\"='approved' AND \"IsDeleted\"=FALSE");
            _mobEnabled   = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"IsEnabled\"=TRUE AND \"IsDeleted\"=FALSE");
            _mapTotal     = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Maps\" WHERE \"IsDeleted\"=FALSE");
            _mapEnabled   = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Maps\" WHERE \"IsEnabled\"=TRUE AND \"IsDeleted\"=FALSE");
            _sysTotal     = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Systems\"");
            _sysEnabled   = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Systems\" WHERE \"IsEnabled\"=TRUE");

            _itemsByType = (await Db.QueryAsync<TypeCount>(
                "SELECT \"ItemType\", COUNT(*) AS \"Count\" FROM \"Items\" WHERE \"ContentStatus\"='approved' AND \"IsDeleted\"=FALSE GROUP BY \"ItemType\" ORDER BY \"Count\" DESC LIMIT 15")).ToList();
            _mobsByRank = (await Db.QueryAsync<RankCount>(
                "SELECT \"Rank\", COUNT(*) AS \"Count\" FROM \"Mobs\" WHERE \"IsDeleted\"=FALSE GROUP BY \"Rank\" ORDER BY \"Count\" DESC")).ToList();

            var highConf  = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ConfidenceScore\" >= 80 AND \"IsDeleted\"=FALSE");
            var midConf   = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ConfidenceScore\" >= 50 AND \"ConfidenceScore\" < 80 AND \"IsDeleted\"=FALSE");
            var lowConf   = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ConfidenceScore\" < 50 AND \"ConfidenceScore\" IS NOT NULL AND \"IsDeleted\"=FALSE");
            var nullConf  = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ConfidenceScore\" IS NULL AND \"IsDeleted\"=FALSE");
            _itemsByConf  = [new("≥80 (vysoká)", highConf, "bg-success"), new("50–79 (střední)", midConf, "bg-warning"), new("<50 (nízká)", lowConf, "bg-danger"), new("Neznámá", nullConf, "bg-secondary")];

            var lvlHigh = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"Level\" >= 80 AND \"IsDeleted\"=FALSE");
            var lvlMid  = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"Level\" >= 40 AND \"Level\" < 80 AND \"IsDeleted\"=FALSE");
            var lvlLow  = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"Level\" < 40 AND \"Level\" IS NOT NULL AND \"IsDeleted\"=FALSE");
            var lvlNull = await Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"Level\" IS NULL AND \"IsDeleted\"=FALSE");
            _mobsByLevel = [new("Lv.80+ (endgame)", lvlHigh, "bg-danger"), new("Lv.40-79", lvlMid, "bg-warning"), new("Lv.1-39", lvlLow, "bg-success"), new("Neznámý", lvlNull, "bg-secondary")];
        }
        catch { }
        finally { _loading = false; }
    }

    private static string ItemTypeName(int? t) => t switch
    {
        0 => "0 – Jiné", 1 => "1 – Zbraň", 2 => "2 – Brnění", 3 => "3 – Helma", 4 => "4 – Přílba",
        5 => "5 – Štít", 6 => "6 – Náhrdelník", 7 => "7 – Prsten", 8 => "8 – Opasek",
        9 => "9 – Boty", 10 => "10 – Plášť", 11 => "11 – Kůň",
        _ => $"{t}"
    };

    private static string MobRankName(int? r) => r switch
    {
        0 => "0 – Normální", 1 => "1 – Silný", 2 => "2 – Elite", 3 => "3 – Unique",
        4 => "4 – Boss", 5 => "5 – Meta Boss", _ => $"{r}"
    };
}
