@page "/stats"
@attribute [Authorize]
@* Interaktivní režim per stránka — layout zůstává SSR; bez toho by @onclick a @bind nefungovaly *@
@rendermode InteractiveServer
@inject IDbService Db

<PageTitle>@S["StatsPageTitle"] — Metin2Bausia</PageTitle>

<h2>@S["StatsHeading"]</h2>

@if (_error != null)
{
    <div class="alert alert-danger">@S["DbError", _error]</div>
}

@if (_loading)
{
    <p>@S["Loading"]</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-bg-primary h-100">
                <div class="card-body">
                    <div class="card-title small text-white-50">@S["ItemsTotal"]</div>
                    <div class="fs-2 fw-bold">@_itemTotal</div>
                    <div class="small text-white-50">@S["ApprovedEnabled", _itemApproved, _itemEnabled]</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-bg-danger h-100">
                <div class="card-body">
                    <div class="card-title small text-white-50">@S["MobsTotal"]</div>
                    <div class="fs-2 fw-bold">@_mobTotal</div>
                    <div class="small text-white-50">@S["ApprovedEnabled", _mobApproved, _mobEnabled]</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-bg-success h-100">
                <div class="card-body">
                    <div class="card-title small text-white-50">@S["MapsCard"]</div>
                    <div class="fs-2 fw-bold">@_mapTotal</div>
                    <div class="small text-white-50">@S["EnabledCount", _mapEnabled]</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-bg-warning h-100">
                <div class="card-body">
                    <div class="card-title small text-white-50">@S["SystemsCard"]</div>
                    <div class="fs-2 fw-bold">@_sysTotal</div>
                    <div class="small text-white-50">@S["EnabledCount", _sysEnabled]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        @* Itemy podle typu *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">@S["ItemsByType"]</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-secondary">
                            <tr><th>@S["Type"]</th><th class="text-end">@S["Count"]</th><th>@S["Share"]</th></tr>
                        </thead>
                        <tbody>
                            @{ int itemMax = _itemsByType.FirstOrDefault()?.Count ?? 1; }
                            @foreach (var row in _itemsByType.Take(15))
                            {
                                <tr>
                                    <td class="small">@ContentLabels.ItemType(row.ItemType)</td>
                                    <td class="text-end small">@row.Count</td>
                                    <td style="min-width:80px">
                                        <div class="progress" style="height:4px">
                                            <div class="progress-bar bg-primary" style="width:@(row.Count * 100 / itemMax)%"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Mobové podle ranku *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">@S["MobsByRank"]</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-secondary">
                            <tr><th>@S["Rank"]</th><th class="text-end">@S["Count"]</th><th>@S["Share"]</th></tr>
                        </thead>
                        <tbody>
                            @{ int mobMax = _mobsByRank.FirstOrDefault()?.Count ?? 1; }
                            @foreach (var row in _mobsByRank)
                            {
                                <tr>
                                    <td class="small">@ContentLabels.Rank(row.Rank)</td>
                                    <td class="text-end small">@row.Count</td>
                                    <td style="min-width:80px">
                                        <div class="progress" style="height:4px">
                                            <div class="progress-bar bg-danger" style="width:@(row.Count * 100 / mobMax)%"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Confidence distribuce itemů *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">@S["ConfidenceItems"]</div>
                <div class="card-body">
                    @{ int totalConf = _itemsByConf.Sum(c => c.Count); }
                    @foreach (var band in _itemsByConf)
                    {
                        int pct = totalConf > 0 ? band.Count * 100 / totalConf : 0;
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="small text-muted" style="min-width:80px">@band.Label</span>
                            <div class="progress flex-grow-1" style="height:14px">
                                <div class="progress-bar @band.Css" style="width:@pct%">
                                    @if (pct > 10) { <span class="small">@band.Count</span> }
                                </div>
                            </div>
                            <span class="small text-muted" style="min-width:30px">@pct%</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Mobové úrovně - rozdělení *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">@S["MobLevelDistribution"]</div>
                <div class="card-body">
                    @{ int totalMobConf = _mobsByLevel.Sum(c => c.Count); }
                    @foreach (var band in _mobsByLevel)
                    {
                        int pct = totalMobConf > 0 ? band.Count * 100 / totalMobConf : 0;
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="small text-muted" style="min-width:80px">@band.Label</span>
                            <div class="progress flex-grow-1" style="height:14px">
                                <div class="progress-bar @band.Css" style="width:@pct%">
                                    @if (pct > 10) { <span class="small">@band.Count</span> }
                                </div>
                            </div>
                            <span class="small text-muted" style="min-width:30px">@pct%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private int _itemTotal, _itemApproved, _itemEnabled;
    private int _mobTotal, _mobApproved, _mobEnabled;
    private int _mapTotal, _mapEnabled;
    private int _sysTotal, _sysEnabled;

    private record TypeCount(string? ItemType, int Count);
    private record RankCount(string? Rank, int Count);
    private record Band(string Label, int Count, string Css);

    private List<TypeCount> _itemsByType = [];
    private List<RankCount> _mobsByRank = [];
    private List<Band> _itemsByConf = [];
    private List<Band> _mobsByLevel = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Všechny dotazy paralelně — každý DbService.QueryFirstOrDefaultAsync otevírá vlastní spojení
            var tItemTotal    = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"IsDeleted\"=FALSE");
            var tItemApproved = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ContentStatus\"='approved' AND \"IsDeleted\"=FALSE");
            var tItemEnabled  = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"IsEnabled\"=TRUE AND \"IsDeleted\"=FALSE");
            var tMobTotal     = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"IsDeleted\"=FALSE");
            var tMobApproved  = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"ContentStatus\"='approved' AND \"IsDeleted\"=FALSE");
            var tMobEnabled   = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"IsEnabled\"=TRUE AND \"IsDeleted\"=FALSE");
            var tMapTotal     = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Maps\" WHERE \"IsDeleted\"=FALSE");
            var tMapEnabled   = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Maps\" WHERE \"IsEnabled\"=TRUE AND \"IsDeleted\"=FALSE");
            var tSysTotal     = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Systems\" WHERE \"IsDeleted\"=FALSE");
            var tSysEnabled   = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Systems\" WHERE \"IsEnabled\"=TRUE AND \"IsDeleted\"=FALSE");
            var tItemsByType  = Db.QueryAsync<TypeCount>("SELECT \"ItemType\", COUNT(*) AS \"Count\" FROM \"Items\" WHERE \"ContentStatus\"='approved' AND \"IsDeleted\"=FALSE GROUP BY \"ItemType\" ORDER BY \"Count\" DESC LIMIT 15");
            var tMobsByRank   = Db.QueryAsync<RankCount>("SELECT \"Rank\", COUNT(*) AS \"Count\" FROM \"Mobs\" WHERE \"IsDeleted\"=FALSE GROUP BY \"Rank\" ORDER BY \"Count\" DESC");
            var tHighConf     = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ConfidenceScore\" >= 80 AND \"IsDeleted\"=FALSE");
            var tMidConf      = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ConfidenceScore\" >= 50 AND \"ConfidenceScore\" < 80 AND \"IsDeleted\"=FALSE");
            var tLowConf      = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ConfidenceScore\" < 50 AND \"ConfidenceScore\" IS NOT NULL AND \"IsDeleted\"=FALSE");
            var tNullConf     = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Items\" WHERE \"ConfidenceScore\" IS NULL AND \"IsDeleted\"=FALSE");
            var tLvlHigh      = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"Level\" >= 80 AND \"IsDeleted\"=FALSE");
            var tLvlMid       = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"Level\" >= 40 AND \"Level\" < 80 AND \"IsDeleted\"=FALSE");
            var tLvlLow       = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"Level\" < 40 AND \"Level\" IS NOT NULL AND \"IsDeleted\"=FALSE");
            var tLvlNull      = Db.QueryFirstOrDefaultAsync<int>("SELECT COUNT(*) FROM \"Mobs\" WHERE \"Level\" IS NULL AND \"IsDeleted\"=FALSE");

            await Task.WhenAll(
                tItemTotal, tItemApproved, tItemEnabled,
                tMobTotal, tMobApproved, tMobEnabled,
                tMapTotal, tMapEnabled, tSysTotal, tSysEnabled,
                tItemsByType, tMobsByRank,
                tHighConf, tMidConf, tLowConf, tNullConf,
                tLvlHigh, tLvlMid, tLvlLow, tLvlNull);

            _itemTotal    = tItemTotal.Result;
            _itemApproved = tItemApproved.Result;
            _itemEnabled  = tItemEnabled.Result;
            _mobTotal     = tMobTotal.Result;
            _mobApproved  = tMobApproved.Result;
            _mobEnabled   = tMobEnabled.Result;
            _mapTotal     = tMapTotal.Result;
            _mapEnabled   = tMapEnabled.Result;
            _sysTotal     = tSysTotal.Result;
            _sysEnabled   = tSysEnabled.Result;
            _itemsByType  = tItemsByType.Result.ToList();
            _mobsByRank   = tMobsByRank.Result.ToList();
            _itemsByConf  = [new(S["ConfHigh"], tHighConf.Result, "bg-success"), new(S["ConfMid"], tMidConf.Result, "bg-warning"), new(S["ConfLow"], tLowConf.Result, "bg-danger"), new(S["ConfUnknown"], tNullConf.Result, "bg-secondary")];
            _mobsByLevel  = [new("Lv.80+ (endgame)", tLvlHigh.Result, "bg-danger"), new("Lv.40-79", tLvlMid.Result, "bg-warning"), new("Lv.1-39", tLvlLow.Result, "bg-success"), new(S["LevelUnknown"], tLvlNull.Result, "bg-secondary")];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }


}
