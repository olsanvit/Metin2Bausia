<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Metin2Bausia.Web</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1900;NU1301</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1301;CS0414;CS0169;CS0219;CS0649;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8613;CS8618;CS8620;CS8625;CS8767;RZ10012</WarningsNotAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedServices\SharedServices\SharedServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.*" />
    <PackageReference Include="Npgsql" Version="10.*" />
    <PackageReference Include="Dapper" Version="2.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.*" />
  </ItemGroup>

</Project>
